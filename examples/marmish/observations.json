  "sourceReferences": [
    "docs/phases/phase-0.md",
    "crates/marmish-core/tests/contracts.rs",
    "crates/marmish-core/src/lib.rs",
    "crates/marmish-core/src/frame.rs",
    "crates/marmish-core/src/config.rs",
