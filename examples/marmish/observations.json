    "README.md"
  ],
  "byteFormat": "Concatenate segments in order. utf8 is literal Unicode encoded as UTF-8, hex is hexadecimal octets, and repeatHex repeats the decoded octets exactly count times.",
  "api": {
    "crate": "marmish-core",
    "exports": [
      "RelaySet",
      "Retention",
      "ConfigError",
      "FrameError",
      "Limits",
      "ProbeEnvelope"
    ],
    "methods": [
      "RelaySet::parse",
      "RelaySet::as_slice",
      "Retention::default",
      "Retention::from_seconds",
      "Retention::seconds",
      "ProbeEnvelope::encode",
      "ProbeEnvelope::decode"
    ],
    "constants": {
      "RAW_BYTES": 16384,
      "JSON_BYTES": 32768,
      "NDJSON_BYTES": 65536,
      "MAX_SECONDS": 31536000
    },
    "frameErrors": [
      "SizeLimit",
      "InvalidJson",
      "InvalidVersion",
      "InvalidEncoding"
    ],
    "configErrors": [
      "EmptyRelaySet",
      "InvalidUrl",
      "DisallowedScheme",
      "DisallowedComponents",
      "DisallowedHost",
      "LoopbackDenied",
      "RetentionOutOfRange"
    ]
  },
  "cases": [
    {
      "id": "encode-empty",
      "operation": "encode",
      "input": [],
      "expected": {
        "bytes": [
          {
            "utf8": "{\"version\":1,\"payload\":\""
          },
          {
            "utf8": "\"}"
          }
        ]
      }
    },
    {
      "id": "decode-empty",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\""
        },
        {
          "utf8": "\"}"
        }
      ],
      "expected": {
        "bytes": []
      }
    },
    {
      "id": "encode-binary",
      "operation": "encode",
      "input": [
        {
          "hex": "00ff800a"
        }
      ],
      "expected": {
        "bytes": [
          {
            "utf8": "{\"version\":1,\"payload\":\""
          },
          {
            "utf8": "AP+ACg=="
          },
          {
            "utf8": "\"}"
          }
        ]
      }
    },
    {
      "id": "decode-binary",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\""
        },
        {
          "utf8": "AP+ACg=="
        },
        {
          "utf8": "\"}"
        }
      ],
      "expected": {
        "bytes": [
          {
            "hex": "00ff800a"
          }
        ]
      }
    },
    {
      "id": "encode-raw-limit",
      "operation": "encode",
      "input": [
        {
          "repeatHex": "ff",
          "count": 16384
        }
      ],
      "expected": {
        "bytes": [
          {
            "utf8": "{\"version\":1,\"payload\":\""
          },
          {
            "repeatHex": "2f",
            "count": 21844
          },
          {
            "utf8": "/w=="
          },
          {
            "utf8": "\"}"
          }
        ]
      }
    },
    {
      "id": "decode-raw-limit",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\""
        },
        {
          "repeatHex": "2f",
          "count": 21844
        },
        {
          "utf8": "/w=="
        },
        {
          "utf8": "\"}"
        }
      ],
      "expected": {
        "bytes": [
          {
            "repeatHex": "ff",
            "count": 16384
          }
        ]
      }
    },
    {
      "id": "encode-raw-plus-one",
      "operation": "encode",
      "input": [
        {
          "repeatHex": "ff",
          "count": 16385
        }
      ],
      "expected": {
        "error": "SizeLimit"
      }
    },
    {
      "id": "decode-raw-plus-one",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\""
        },
        {
          "repeatHex": "2f",
          "count": 21844
        },
        {
          "utf8": "//8="
        },
        {
          "utf8": "\"}"
        }
      ],
      "expected": {
        "error": "SizeLimit"
      }
    },
    {
      "id": "json-32768",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\"\"}"
        },
        {
          "repeatHex": "20",
          "count": 32742
        }
      ],
      "expected": {
        "bytes": []
      }
    },
    {
      "id": "json-32769",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\"\"}"
        },
        {
          "repeatHex": "20",
          "count": 32743
        }
      ],
      "expected": {
        "error": "SizeLimit"
      }
    },
    {
      "id": "whitespace-and-reordered",
      "operation": "decode",
      "input": [
        {
          "utf8": " \t{ \"payload\" : \"Zg==\",\n \"version\" : 1 }\r\n"
        }
      ],
      "expected": {
        "bytes": [
          {
            "hex": "66"
          }
        ]
      }
    },
    {
      "id": "unknown",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\"\",\"other\":0}"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
    {
      "id": "duplicate-version",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"version\":1,\"payload\":\"\"}"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
    {
      "id": "duplicate-payload",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\"\",\"payload\":\"\"}"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
    {
      "id": "missing",
      "operation": "decode",
      "input": [
        {
          "utf8": "{}"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
    {
      "id": "wrong-type",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":4}"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
    {
      "id": "trailing",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":1,\"payload\":\"\"} trailing"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
    {
      "id": "negative-version",
      "operation": "decode",
      "input": [
        {
          "utf8": "{\"version\":-1,\"payload\":\"\"}"
        }
      ],
      "expected": {
        "error": "InvalidJson"
      }
    },
