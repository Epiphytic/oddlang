
fn perform(path: &Path/*request_parameter*/) -> Result<Response, Failure> {
    let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().map_err(|_| IO)?;
    runtime.block_on(async {
        tokio::time::timeout(Duration::from_millis(DEADLINE_MS), exchange(path/*request_argument*/))
            .await.map_err(|_| DEADLINE)?
    })
}
