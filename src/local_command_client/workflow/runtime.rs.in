use schema::{ArgumentKind, BinaryOutput, CaptureKind, Effect, EmbeddedReply, Field, Source, Workflow};
use serde_json::Value;
use std::collections::{BTreeMap, BTreeSet};

type Response = strict_json::Strict;

fn field_at<'a>(root: &'a Value, path: &[String], delivery: bool) -> Option<&'a Value> {
    path.iter().try_fold(root, |value, key| {
        if let Some(array) = value.as_array().filter(|_| delivery) {
            if !key.bytes().all(|byte| byte.is_ascii_digit())
                || (key.len() > 1 && key.starts_with('0'))
            {
                return None;
            }
            array.get(key.parse::<usize>().ok()?)
        } else {
            value.get(key)
        }
    })
}

fn explicit_argument(matches: &ArgMatches, id: &str) -> bool {
    matches.value_source(id) == Some(clap::parser::ValueSource::CommandLine)
}

fn argument_value(matches: &ArgMatches, id: &str, kind: ArgumentKind) -> Result<Value, Failure> {
    use serde_json::json;
    Ok(match kind {
        ArgumentKind::String => json!(matches.try_get_one::<String>(id).map_err(|_| BINDING)?
            .filter(|_| explicit_argument(matches, id)).ok_or(BINDING)?),
        ArgumentKind::RepeatedString => json!(matches.try_get_many::<String>(id).map_err(|_| BINDING)?
            .filter(|_| explicit_argument(matches, id)).map(|items| items.collect::<Vec<_>>()).unwrap_or_default()),
        ArgumentKind::Unsigned64 => json!(matches.try_get_one::<u64>(id).map_err(|_| BINDING)?
            .filter(|_| explicit_argument(matches, id)).ok_or(BINDING)?),
        ArgumentKind::Flag => json!(matches.try_get_one::<bool>(id).map_err(|_| BINDING)?
            .filter(|_| explicit_argument(matches, id)).copied().unwrap_or(false)),
    })
}

fn append(body: &mut Vec<u8>, input: &[u8]) -> Result<(), Failure> {
    if input.len() > FRAME_LIMIT as usize - body.len() {
        return Err(FRAME_SIZE);
    }
    body.extend_from_slice(input);
    Ok(())
}

fn request(
    body: &mut Vec<u8>,
    fields: &[Field],
    matches: &ArgMatches,
    values: &BTreeMap<&str, Value>,
    inputs: &BTreeMap<String, Value>,
) -> Result<(), Failure> {
    append(body, b"{")?;
    for (position, field) in fields.iter().enumerate() {
        if position > 0 {
            append(body, b",")?;
        }
        let key = serde_json::to_vec(&field.key).map_err(|_| FRAME_JSON)?;
        append(body, &key)?;
        append(body, b":")?;
        append(body, &source_bytes(&field.source, matches, values, inputs)?)?;
    }
    append(body, b"}")
}

fn source_bytes(
    source: &Source,
    matches: &ArgMatches,
    values: &BTreeMap<&str, Value>,
    inputs: &BTreeMap<String, Value>,
) -> Result<Vec<u8>, Failure> {
    match source {
        Source::Object { fields } | Source::Sha256 { fields } => {
            let mut body = Vec::new();
            request(&mut body, fields, matches, values, inputs)?;
            if matches!(source, Source::Sha256 { .. }) {
                return serde_json::to_vec(&native_digest(&body)?).map_err(|_| FRAME_JSON);
            }
            Ok(body)
        }
        Source::Literal { value } => serde_json::to_vec(value).map_err(|_| FRAME_JSON),
        Source::Argument { id, value_kind } => serde_json::to_vec(&argument_value(matches, id, *value_kind)?).map_err(|_| FRAME_JSON),
        Source::Captured { name } => serde_json::to_vec(values.get(name.as_str()).ok_or(PROTOCOL)?).map_err(|_| FRAME_JSON),
        Source::Input { name } => serde_json::to_vec(inputs.get(name).ok_or(PROTOCOL)?).map_err(|_| FRAME_JSON),
    }
}

fn capture_is_valid(value: &Value, kind: &CaptureKind) -> bool {
    match kind {
        CaptureKind::LowerHex { bytes } => value.as_str().is_some_and(|text| {
            text.len() == usize::from(*bytes) * 2
                && text.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
        }),
        CaptureKind::String { maximum_bytes } => {
            value.as_str().is_some_and(|text| text.len() <= *maximum_bytes as usize)
        }
        CaptureKind::Unsigned64 => value.as_u64().is_some(),
        CaptureKind::JsonObject { maximum_bytes } => value.is_object()
            && serde_json::to_vec(value).is_ok_and(|bytes| bytes.len() <= *maximum_bytes as usize),
        CaptureKind::ExitStatus => value.as_u64().is_some_and(|status| u8::try_from(status).is_ok()),
    }
}

fn report_record(
    record: &schema::Record, matches: &ArgMatches, captured: &BTreeMap<&str, Value>,
    inputs: &BTreeMap<String, Value>,
) -> Result<(), Failure> {
    let bytes = source_bytes(&record.source, matches, captured, inputs)?;
    let mut stderr = std::io::stderr().lock();
    stderr.write_all(record.prefix.as_bytes()).and_then(|_| stderr.write_all(&bytes))
        .and_then(|_| stderr.write_all(b"\n")).and_then(|_| stderr.flush()).map_err(|_| IO)
}

fn reject_reply(
    step: &schema::Step, matches: &ArgMatches, captured: &BTreeMap<&str, Value>,
    inputs: &BTreeMap<String, Value>,
) -> Result<u8, Failure> {
    let reject = step.reject.as_ref().ok_or(PROTOCOL)?;
    if let Some(record) = &reject.record { report_record(record, matches, captured, inputs)?; }
    writeln!(std::io::stderr().lock(), "{}", reject.diagnostic.stderr).map_err(|_| IO)?;
    Ok(reject.diagnostic.exit)
}

async fn run_workflow(
    workflow: &Workflow,
    path: &Path,
    matches: &ArgMatches,
    inputs: &BTreeMap<String, Value>,
) -> Result<u8, Failure> {
    let mut state = workflow.entry.as_str();
    let mut captured = BTreeMap::new();
    let mut issued = BTreeSet::new();
    for exchange_index in 0..workflow.transport.maximum_exchanges {
        let step = workflow.steps.iter().find(|step| step.id == state).ok_or(PROTOCOL)?;
        let mut body = Vec::new();
        request(&mut body, &step.request, matches, &captured, inputs)?;
        let strict_json::Strict(mut reply) = exchange(path, &body).await?;
        if let Some(embedded) = &step.embedded {
            if open_embedded(state, &mut reply, embedded).is_err() {
                return reject_reply(step, matches, &captured, inputs);
            }
        }
        let mut transition = None;
        for selected in &step.transitions {
            let mut matches_all = true;
            for (name, expected) in &selected.flags {
                let flag = matches.try_get_one::<bool>(name).map_err(|_| BINDING)?
                    .filter(|_| explicit_argument(matches, name)).copied().unwrap_or(false);
                if flag != *expected { matches_all = false; break; }
            }
            if !matches_all { continue; }
            for predicate in &selected.when {
                if let Some(values) = &predicate.one_of {
                    if !field_at(&reply, &predicate.path, workflow.delivery).is_some_and(|value| values.contains(value)) {
                        matches_all = false;
                        break;
                    }
                    continue;
                }
                let expected = if let Some(source) = &predicate.equals_source {
                    serde_json::from_slice(&source_bytes(source, matches, &captured, inputs)?)
                        .map_err(|_| FRAME_JSON)?
                } else if let Some(path) = &predicate.equals_path {
                    let Some(value) = field_at(&reply, path, workflow.delivery) else {
                        matches_all = false;
                        break;
                    };
                    value.clone()
                } else {
                    predicate.equals.as_ref().ok_or(PROTOCOL)?.clone()
                };
                if field_at(&reply, &predicate.path, workflow.delivery) != Some(&expected) {
                    matches_all = false;
                    break;
                }
            }
            if matches_all {
                transition = Some(selected);
                break;
            }
        }
        let Some(transition) = transition else {
            return reject_reply(step, matches, &captured, inputs);
        };
        let mut transferred = BTreeMap::new();
        for name in &transition.carry {
            let value = captured.get(name.as_str()).ok_or(PROTOCOL)?;
            transferred.insert(name.as_str(), value.clone());
        }
        for field in &transition.capture {
            let value = field_at(&reply, &field.path, workflow.delivery)
                .filter(|value| capture_is_valid(value, &field.value_kind))
                .ok_or(PROTOCOL)?;
            transferred.insert(field.name.as_str(), value.clone());
        }
        if let Some(name) = &transition.fresh_id {
            let id = fresh_profile_id(workflow)?;
            if inputs.values().any(|value| value.as_str() == Some(&id)) || !issued.insert(id.clone()) {
                return Err(PROTOCOL);
            }
            transferred.insert(name.as_str(), Value::String(id));
        }
        for binding in &transition.bindings {
            let left = source_bytes(&binding.left, matches, &transferred, inputs)?;
            let right = source_bytes(&binding.right, matches, &transferred, inputs)?;
            if left != right {
                return reject_reply(step, matches, &captured, inputs);
            }
        }
        let captured_exit = match &transition.effect {
            Effect::ExitCaptured { name } => Some(transferred.get(name.as_str())
                .and_then(Value::as_u64).and_then(|n| u8::try_from(n).ok()).ok_or(PROTOCOL)?),
            _ => None,
        };
        if matches!(transition.effect, Effect::Continue { .. })
            && exchange_index + 1 == workflow.transport.maximum_exchanges
        {
            return Err(BUDGET);
        }
        match emit_outputs(&reply, &transition.outputs, &captured, &transferred) {
            Err(error) if error.0 == PROTOCOL.0 && error.1 == PROTOCOL.1 => {
                return reject_reply(step, matches, &captured, inputs);
            }
            value => value?,
        }
        if let Some(record) = &transition.record { report_record(record, matches, &captured, inputs)?; }
        captured = transferred;
        match &transition.effect {
            Effect::Continue { step, delay_ms } => {
                state = step;
                if *delay_ms != 0 {
                    tokio::time::sleep(Duration::from_millis(u64::from(*delay_ms))).await;
                }
            }
            Effect::Exit { status, stderr } => {
                if !stderr.is_empty() {
                    writeln!(std::io::stderr().lock(), "{stderr}").map_err(|_| IO)?;
                }
                return Ok(*status);
            }
            Effect::ExitCaptured { .. } => return captured_exit.ok_or(PROTOCOL),
        }
    }
    Err(BUDGET)
}

fn execute_workflow(matches: &ArgMatches) -> Result<u8, Failure> {
    let workflow: Workflow = serde_json::from_str(WORKFLOW).map_err(|_| PROTOCOL)?;
    let inputs = initial_inputs(&workflow, matches)?;
    let explicit = matches.try_get_one::<PathBuf>(&workflow.socket_argument).map_err(|_| BINDING)?;
    let path = choose_socket(matches, explicit)?;
    let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().map_err(|_| IO)?;
    runtime.block_on(async {
        tokio::time::timeout(Duration::from_millis(DEADLINE_MS), run_workflow(&workflow, &path, matches, &inputs))
            .await.map_err(|_| DEADLINE)?
    })
}
