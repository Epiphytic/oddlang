use profile_schema::{InputDocument, InputTest, Payload, ProfileInputs};
use std::{
    ffi::{CString, OsStr, OsString},
    fs::File,
    io::{self, Read},
    os::{
        fd::{AsRawFd, FromRawFd, RawFd},
        unix::{ffi::OsStrExt, fs::MetadataExt},
    },
    time::{Instant, SystemTime, UNIX_EPOCH},
};
use base64::{Engine as _, engine::general_purpose::STANDARD};
use nostr::{key::PublicKey, nips::nip19::FromBech32};

fn private_openat(parent: RawFd, path: &OsStr, directory: bool) -> io::Result<File> {
    let path = CString::new(path.as_bytes()).map_err(|_| io::ErrorKind::InvalidInput)?;
    let flags = libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK
        | if directory { libc::O_DIRECTORY } else { 0 };
    // SAFETY: The CString is nul-terminated. The caller retains the parent descriptor.
    let fd = unsafe { libc::openat(parent, path.as_ptr(), flags) };
    if fd == -1 {
        return Err(io::Error::last_os_error());
    }
    // SAFETY: openat just returned a new, owned descriptor.
    Ok(unsafe { File::from_raw_fd(fd) })
}

fn private_metadata(file: &File, directory: bool, mode: u32) -> io::Result<bool> {
    let meta = file.metadata()?;
    // SAFETY: geteuid has no preconditions.
    let uid = unsafe { libc::geteuid() };
    Ok(meta.uid() == uid && meta.mode() & 0o777 == mode
        && if directory { meta.is_dir() } else { meta.is_file() && meta.nlink() == 1 })
}

fn get_account(text: &str) -> Option<String> {
    if text.starts_with("npub1") {
        PublicKey::from_bech32(text).ok().map(|key| key.to_hex())
    } else if lower_hex(text, 32) {
        PublicKey::from_hex(text).ok().map(|key| key.to_hex())
    } else {
        None
    }
}

fn lower_hex(text: &str, byte_width: usize) -> bool {
    text.len() == byte_width * 2
        && text.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
}

fn account_set(value: &Value, maximum: usize) -> Option<std::collections::BTreeSet<String>> {
    let list = value.as_array()?;
    if list.len() > maximum {
        return None;
    }
    let mut normalized = std::collections::BTreeSet::new();
    for value in list {
        if !normalized.insert(get_account(value.as_str()?)?) {
            return None;
        }
    }
    Some(normalized)
}

fn valid_v3_onion(host: &str) -> bool {
    use sha3::Digest as _;
    let Some(label) = host.strip_suffix(".onion") else {
        return false;
    };
    if label.len() != 56 || !label.bytes().all(|b| matches!(b, b'a'..=b'z' | b'2'..=b'7')) {
        return false;
    }
    let Ok(decoded) = data_encoding::BASE32_NOPAD.decode(label.to_ascii_uppercase().as_bytes()) else {
        return false;
    };
    let Ok(address): Result<[u8; 35], _> = decoded.try_into() else {
        return false;
    };
    let version = [address[34]];
    let digest = sha3::Sha3_256::digest([b".onion checksum".as_slice(), &address[..32], &version].concat());
    version == [3] && address[32..34] == digest[..2]
}

fn canonical_relays<'a>(
    texts: impl IntoIterator<Item = &'a str>,
    route: &str,
    doc: &InputDocument,
) -> Option<Vec<String>> {
    let mut canonical = std::collections::BTreeSet::new();
    for (position, text) in texts.into_iter().enumerate() {
        if position >= doc.maximum_relays || text.len() > doc.maximum_relay_bytes || text.contains('\\')
            || text.chars().any(|c| c.is_whitespace() || c.is_control())
        {
            return None;
        }
        let (_, after_scheme) = text.split_once("://")?;
        let authority = after_scheme.split('/').next()?;
        if authority.ends_with(':') || authority.contains('@') || authority.rsplit_once(':')
            .is_some_and(|(_, port)| !port.ends_with(']') && port.len() > 1 && port.starts_with('0'))
        {
            return None;
        }
        let url = url::Url::parse(text).ok()?;
        let host = url.host_str()?;
        if host.is_empty() || host.ends_with('.') || host.contains('%')
            || !url.username().is_empty() || url.password().is_some() || url.query().is_some()
            || url.fragment().is_some() || url.port() == Some(0)
            || !doc.relay_rules.iter().any(|rule| {
                rule.scheme == url.scheme() && rule.routes.iter().any(|value| value == route)
                    && (!rule.v3_onion || valid_v3_onion(host))
                    && match &rule.host_suffix {
                        Some(suffix) => host.ends_with(suffix),
                        None => !doc.relay_rules.iter().any(|other| {
                            other.host_suffix.as_ref().is_some_and(|suffix| host.ends_with(suffix))
                        }),
                    }
            })
        {
            return None;
        }
        canonical.insert(String::from(url));
    }
    if canonical.is_empty() { None } else { Some(canonical.into_iter().collect()) }
}

fn timestamped_id(payload: &Payload) -> Option<String> {
    let now = SystemTime::now().duration_since(UNIX_EPOCH).ok()?.as_secs();
    let clock = now.to_be_bytes();
    let cutoff = clock.len().checked_sub(payload.timestamp_bytes as usize)?;
    if clock[..cutoff].iter().any(|byte| *byte != 0) {
        return None;
    }
    let mut entropy = vec![0; payload.random_bytes as usize];
    getrandom::fill(&mut entropy).ok()?;
    let mut id = String::new();
    use std::fmt::Write as _;
    for byte in clock[cutoff..].iter().chain(&entropy) {
        write!(id, "{byte:02x}").ok()?;
    }
    Some(id)
}

fn profile_flag(matches: &ArgMatches, name: &str) -> Result<bool, Failure> {
    Ok(matches.try_get_one::<bool>(name).map_err(|_| BINDING)?
        .filter(|_| explicit_argument(matches, name)).copied().unwrap_or(false))
}

fn read_command_stdin(maximum: usize, timeout: Duration) -> Result<Vec<u8>, Failure> {
    let started = Instant::now();
    let mut bytes = Vec::new();
    let mut buffer = [0; 4096];
    loop {
        let remaining = timeout.checked_sub(started.elapsed()).ok_or(PROFILE_STDIN_TIMEOUT)?;
        let mut fd = libc::pollfd { fd: 0, events: libc::POLLIN, revents: 0 };
        let ms = i32::try_from(remaining.as_millis()).unwrap_or(i32::MAX).max(1);
        // SAFETY: fd is initialized and points to one valid writable pollfd.
        let result = unsafe { libc::poll(&mut fd, 1, ms) };
        if result < 0 && io::Error::last_os_error().kind() == io::ErrorKind::Interrupted {
            continue;
        }
        if result < 0 {
            return Err(IO);
        }
        if result == 0 {
            return Err(PROFILE_STDIN_TIMEOUT);
        }
        let available = (maximum + 1 - bytes.len()).min(buffer.len());
        // SAFETY: The writable buffer is valid for the requested number of bytes.
        let count = unsafe { libc::read(0, buffer.as_mut_ptr().cast(), available) };
        if count < 0 {
            if io::Error::last_os_error().kind() == io::ErrorKind::Interrupted {
                continue;
            }
            return Err(IO);
        }
        let count = count as usize;
        if count == 0 {
            return Ok(bytes);
        }
        bytes.extend_from_slice(&buffer[..count]);
        if bytes.len() > maximum {
            return Err(PROFILE_BYTES);
        }
    }
}

fn load_profile_document<'a>(
    policy: &'a ProfileInputs,
    matches: &'a ArgMatches,
) -> Result<(Value, &'a str, File), Failure> {
    let doc = &policy.document;
    let args = &policy.arguments;
    let base = matches.try_get_one::<PathBuf>(&args.state).map_err(|_| BINDING)?
        .filter(|_| explicit_argument(matches, &args.state)).ok_or(PROFILE_PATH)?;
    let profile = matches.try_get_one::<String>(&args.profile).map_err(|_| BINDING)?
        .filter(|_| explicit_argument(matches, &args.profile))
        .map_or(args.default_profile.as_str(), String::as_str);
    if profile.len() > doc.profile_name_maximum_bytes as usize
        || profile.is_empty() || matches!(profile, "." | "..") || !profile.bytes().all(|b| b.is_ascii_alphanumeric()
            || doc.profile_name_punctuation.as_bytes().contains(&b))
    {
        return Err(PROFILE_PATH);
    }
    let state = private_openat(libc::AT_FDCWD, base.as_os_str(), true).map_err(|_| /*state_directory_error*/)?;
    if !private_metadata(&state, true, doc.directory_mode).map_err(|_| IO)? {
        return Err(/*state_directory_error*/);
    }
    let profile_dir = private_openat(state.as_raw_fd(), OsStr::new(profile), true).map_err(/*profile_open_failure*/)?;
    if !private_metadata(&profile_dir, true, doc.directory_mode).map_err(|_| IO)? {
        return Err(PROFILE_PATH);
    }
    let file = private_openat(profile_dir.as_raw_fd(), OsStr::new(&doc.leaf), false).map_err(|_| /*document_open_error*/)?;
    if !private_metadata(&file, false, doc.file_mode).map_err(|_| IO)? {
        return Err(/*document_metadata_error*/);
    }
    let mut contents = Vec::new();
    file.take(u64::from(doc.maximum_bytes) + 1).read_to_end(&mut contents).map_err(|_| IO)?;
    if contents.len() > doc.maximum_bytes as usize {
        return Err(PROFILE_SIZE);
    }
    let strict_json::Strict(value) = serde_json::from_slice(&contents).map_err(|_| PROFILE_SCHEMA)?;
    let object = value.as_object().ok_or(PROFILE_SCHEMA)?;
    if object.len() != doc.checks.len() + 3 {
        return Err(PROFILE_SCHEMA);
    }
    for check in &doc.checks {
        let field = object.get(&check.field).ok_or(PROFILE_SCHEMA)?;
        let valid = match &check.test {
            InputTest::OneOf { values } => values.contains(field),
            InputTest::Object => field.is_object(),
            InputTest::NullOrAbsolutePath => field.is_null() || field.as_str().is_some_and(|text| {
                !text.contains('\0') && text.len() <= 4095 && Path::new(text).is_absolute()
            }),
            InputTest::AccountSet => account_set(field, doc.maximum_accounts).is_some(),
        };
        if !valid {
            return Err(PROFILE_SCHEMA);
        }
    }
    Ok((value, profile, profile_dir))
}

fn resume_inputs(
    policy: &ProfileInputs, resume: &profile_schema::Resume, matches: &ArgMatches,
    configuration: &Value, profile: &str, directory: &File,
) -> Result<BTreeMap<String, Value>, Failure> {
    let child = matches.subcommand_matches(&resume.command).ok_or(PROFILE_SCOPE)?;
    let text = child.try_get_one::<String>(&resume.handle_argument).map_err(|_| BINDING)?
        .filter(|_| explicit_argument(child, &resume.handle_argument)).ok_or(PROFILE_SCOPE)?;
    if text.len() > resume.maximum_handle_bytes as usize { return Err(PROFILE_SCOPE); }
    let strict_json::Strict(handle) = serde_json::from_str(text).map_err(|_| PROFILE_SCOPE)?;
    let keys = &resume.handle_fields;
    if !handle.as_object().is_some_and(|fields| fields.len() == 6)
        || handle.get(&keys.version_key).and_then(Value::as_u64) != Some(u64::from(keys.version))
        || handle.get(&keys.profile).and_then(Value::as_str) != Some(profile)
    {
        return Err(PROFILE_SCOPE);
    }
    let hex = |key: &str, bytes| handle.get(key).and_then(Value::as_str)
        .filter(|text| lower_hex(text, bytes)).ok_or(PROFILE_SCOPE);
    let remote = hex(&keys.remote, 32)?;
    let session = hex(&keys.session, 16)?;
    let invocation = hex(&keys.invocation, 16)?;
    let digest = hex(&keys.digest, 32)?;
    let allowed = account_set(configuration.get(&policy.document.trusted).ok_or(PROFILE_SCHEMA)?,
                              policy.document.maximum_accounts).ok_or(PROFILE_SCHEMA)?;
    if !allowed.contains(remote) { return Err(PROFILE_AUTHORITY); }
    let manifest = &resume.manifest;
    let file = private_openat(directory.as_raw_fd(), OsStr::new(&manifest.leaf), false).map_err(|_| PROFILE_FILE)?;
    if !private_metadata(&file, false, policy.document.file_mode).map_err(|_| IO)? {
        return Err(PROFILE_FILE);
    }
    let mut contents = Vec::new();
    file.take(u64::from(manifest.maximum_bytes) + 1).read_to_end(&mut contents).map_err(|_| IO)?;
    if contents.len() > manifest.maximum_bytes as usize { return Err(PROFILE_SIZE); }
    let strict_json::Strict(account) = serde_json::from_slice(&contents).map_err(|_| PROFILE_SCHEMA)?;
    if account.get(&manifest.version_key).and_then(Value::as_u64) != Some(u64::from(manifest.version))
        || account.get(&manifest.name_key).and_then(Value::as_str) != Some(profile)
        || account.get(&manifest.phase_key).and_then(Value::as_str) != Some(manifest.ready.as_str())
    {
        return Err(PROFILE_SCHEMA);
    }
    let local = account.get(&manifest.account_key).and_then(Value::as_str)
        .filter(|account| lower_hex(account, 32)).and_then(get_account).ok_or(PROFILE_SCHEMA)?;
    use serde_json::json;
    let outputs = &policy.outputs;
    Ok(BTreeMap::from([
        (outputs.remote.clone(), json!(remote)),
        (outputs.invocation.clone(), json!(invocation)),
        (outputs.selected_profile.clone().ok_or(PROTOCOL)?, json!(profile)),
        (resume.local_account_output.clone(), json!(local)),
        (resume.session_output.clone(), json!(session)),
        (resume.digest_output.clone(), json!(digest)),
    ]))
}

fn context_values(policy: &ProfileInputs, matches: &ArgMatches) -> Result<BTreeMap<String, Value>, Failure> {
    let args = &policy.arguments;
    for name in &args.required_flags {
        if !profile_flag(matches, name)? {
            return Err(PROFILE_SCOPE);
        }
    }
    for name in &args.excluded_flags {
        if profile_flag(matches, name)? {
            return Err(PROFILE_SCOPE);
        }
    }
    for argument in &args.excluded_values {
        if matches.try_contains_id(&argument.id).map_err(|_| BINDING)?
            && explicit_argument(matches, &argument.id) {
            return Err(PROFILE_SCOPE);
        }
    }
    let doc = &policy.document;
    let (value, selected_profile, directory) = load_profile_document(policy, matches)?;
    let destination = if policy.resume.is_some() {
        None
    } else {
        let (principal, external) = matches.subcommand().ok_or(PROFILE_DESTINATION)?;
        if !principal.starts_with("npub1") || principal.len() != 63 {
            return Err(PROFILE_DESTINATION);
        }
        let remote = get_account(principal).ok_or(PROFILE_DESTINATION)?;
        let authorized = account_set(value.get(&doc.trusted).ok_or(PROFILE_SCHEMA)?, doc.maximum_accounts)
            .ok_or(PROFILE_SCHEMA)?;
        if !authorized.contains(&remote) {
            return Err(PROFILE_AUTHORITY);
        }
        Some((remote, external))
    };
    let profile_route = value.get(&doc.route).and_then(Value::as_str).ok_or(PROFILE_SCHEMA)?;
    let route = matches.try_get_one::<String>(&args.route).map_err(|_| BINDING)?
        .filter(|_| explicit_argument(matches, &args.route));
    if route.is_some_and(|route| route != profile_route) {
        return Err(PROFILE_RELAYS);
    }
    let configured = value.get(&doc.relay).and_then(Value::as_array).ok_or(PROFILE_SCHEMA)?.iter()
        .map(|field| field.as_str().ok_or(PROFILE_SCHEMA)).collect::<Result<Vec<_>, _>>()?;
    let relays = canonical_relays(configured, profile_route, doc).ok_or(PROFILE_RELAYS)?;
    if let Some(requested) = matches.try_get_many::<String>(&args.relay).map_err(|_| BINDING)?
        .filter(|_| explicit_argument(matches, &args.relay)) {
        let supplied = canonical_relays(requested.map(String::as_str), profile_route, doc)
            .ok_or(PROFILE_RELAYS)?;
        if supplied != relays {
            return Err(PROFILE_RELAYS);
        }
    }
    if let Some(resume) = &policy.resume {
        return resume_inputs(policy, resume, matches, &value, selected_profile, &directory);
    }
    let (remote, external) = destination.ok_or(PROFILE_SCOPE)?;
    let mut raw = external.try_get_many::<OsString>("").map_err(|_| PROFILE_ARGV)?.ok_or(PROFILE_ARGV)?;
    if raw.next().map(OsString::as_os_str) != Some(OsStr::new("--")) {
        return Err(PROFILE_SEPARATOR);
    }
    let arguments = raw.map(|word| word.as_os_str().as_bytes()).collect::<Vec<_>>();
    if arguments.first().is_none_or(|path| path.is_empty())
        || arguments.iter().any(|item| item.contains(&0))
    {
        return Err(PROFILE_ARGV);
    }
    let payload = &policy.payload;
    if arguments.len() > payload.maximum_arguments || arguments.iter()
        .try_fold(0usize, |total, word| total.checked_add(word.len())?.checked_add(1))
        .is_none_or(|total| total > payload.maximum_argument_bytes)
    {
        return Err(PROFILE_BYTES);
    }
    use std::io::IsTerminal as _;
    let input = if profile_flag(matches, &args.stdin)?
        || (!profile_flag(matches, &args.stdin_none)? && !io::stdin().is_terminal())
    {
        read_command_stdin(payload.maximum_stdin_bytes, Duration::from_millis(u64::from(payload.stdin_timeout_ms)))?
    } else {
        Vec::new()
    };
    let request = timestamped_id(payload).ok_or(PROFILE_RANDOM)?;
    let invocation = timestamped_id(payload).ok_or(PROFILE_RANDOM)?;
    if request == invocation {
        return Err(PROFILE_RANDOM);
    }
    use serde_json::json;
    let outputs = &policy.outputs;
    let mut values = BTreeMap::from([
        (outputs.remote.clone(), json!(remote)),
        (outputs.relays.clone(), json!(relays)),
        (outputs.argv.clone(), json!(arguments.into_iter().map(|argument| STANDARD.encode(argument)).collect::<Vec<_>>())),
        (outputs.stdin.clone(), json!(STANDARD.encode(input))),
        (outputs.request.clone(), json!(request)),
        (outputs.invocation.clone(), json!(invocation)),
    ]);
    if let Some(name) = &outputs.selected_profile {
        values.insert(name.clone(), json!(selected_profile));
    }
    if let Some(name) = &outputs.followup_request {
        let next = timestamped_id(payload).ok_or(PROFILE_RANDOM)?;
        if next == request || next == invocation {
            return Err(PROFILE_RANDOM);
        }
        values.insert(name.clone(), json!(next));
    }
    Ok(values)
}
