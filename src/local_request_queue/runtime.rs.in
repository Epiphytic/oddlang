use ::rusqlite::{params, Connection, ErrorCode, OptionalExtension, TransactionBehavior};
use ::sha2::{Digest, Sha256};

pub type Account = [u8; ACCOUNT_BYTES as usize];
pub type Room = [u8; ROOM_BYTES as usize];
pub type Id = [u8; ID_BYTES as usize];

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct QueueScope {
    pub account: Account,
    pub room: Room,
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum RequestKind {
    Initial,
    FollowUp,
}

#[derive(Clone, Copy, Debug)]
pub struct Request<'a> {
    pub scope: QueueScope,
    pub request_id: Id,
    pub invocation_id: Id,
    pub kind: RequestKind,
    pub digest: [u8; 32],
    pub frame: &'a [u8],
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct QueueReceipt {
    pub scope: QueueScope,
    pub request_id: Id,
    pub invocation_id: Id,
    pub kind: RequestKind,
    pub digest: [u8; 32],
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum Enqueued {
    Queued(QueueReceipt),
    AlreadyQueued(QueueReceipt),
}

impl Enqueued {
    pub fn receipt(&self) -> &QueueReceipt {
        match self {
            Self::Queued(receipt) | Self::AlreadyQueued(receipt) => receipt,
        }
    }
}

#[derive(Debug, Eq, PartialEq)]
pub struct QueuedFrame {
    pub receipt: QueueReceipt,
    pub frame: Vec<u8>,
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum QueueError {
    Scope,
    Frame,
    Digest,
    RequestCollision,
    InvocationCollision,
    MissingInvocation,
    Contract,
    NonDurable,
    TransactionActive,
    Busy,
    Corrupt,
    Storage,
}

impl From<::rusqlite::Error> for QueueError {
    fn from(error: ::rusqlite::Error) -> Self {
        match error.sqlite_error_code() {
            Some(ErrorCode::DatabaseBusy | ErrorCode::DatabaseLocked) => Self::Busy,
            _ => Self::Storage,
        }
    }
}

pub struct LocalQueue<'a> {
    connection: &'a mut Connection,
    authorized: QueueScope,
}

impl<'a> LocalQueue<'a> {
    /// Attach to the caller's durable, already configured database.
    pub fn attach(
        connection: &'a mut Connection,
        authorized: QueueScope,
    ) -> Result<Self, QueueError> {
        if !connection.is_autocommit() {
            return Err(QueueError::TransactionActive);
        }
        let mode: String =
            connection.pragma_query_value(Some("main"), "journal_mode", |row| row.get(0))?;
        let synchronous: i64 =
            connection.pragma_query_value(Some("main"), "synchronous", |row| row.get(0))?;
        if connection.path().is_none_or(str::is_empty)
            || !matches!(mode.as_str(), "delete" | "truncate" | "persist" | "wal")
            || synchronous < 2
        {
            return Err(QueueError::NonDurable);
        }

        let transaction = connection.transaction_with_behavior(TransactionBehavior::Immediate)?;
        if install_schema(&transaction)? {
            transaction.execute(
                "INSERT INTO main.oddlang_queue_contract_v1 VALUES (1, ?1, ?2, ?3, ?4, ?5)",
                params![
                    CONTRACT_ID,
                    ACCOUNT_BYTES,
                    ROOM_BYTES,
                    ID_BYTES,
                    MAX_FRAME_BYTES
                ],
            )?;
        }
        let compatible: Option<bool> = transaction
            .query_row(
                "SELECT name = ?1 AND account_bytes = ?2 AND room_bytes = ?3 AND id_bytes = ?4
                 AND max_frame = ?5 FROM main.oddlang_queue_contract_v1 WHERE only_row = 1",
                params![
                    CONTRACT_ID,
                    ACCOUNT_BYTES,
                    ROOM_BYTES,
                    ID_BYTES,
                    MAX_FRAME_BYTES
                ],
                |row| row.get(0),
            )
            .optional()?;
        if compatible != Some(true) {
            return Err(QueueError::Contract);
        }
        transaction.commit()?;
        Ok(Self {
            connection,
            authorized,
        })
    }

    pub fn enqueue(&mut self, request: Request<'_>) -> Result<Enqueued, QueueError> {
        self.check_scope(request.scope)?;
        validate(request.frame, &request.digest)?;
        let transaction = self
            .connection
            .transaction_with_behavior(TransactionBehavior::Immediate)?;
        let receipt = QueueReceipt {
            scope: request.scope,
            request_id: request.request_id,
            invocation_id: request.invocation_id,
            kind: request.kind,
            digest: request.digest,
        };
        if let Some(previous) = read(&transaction, request.scope, request.request_id)? {
            if previous.receipt != receipt || previous.frame != request.frame {
                return Err(QueueError::RequestCollision);
            }
            transaction.commit()?;
            return Ok(Enqueued::AlreadyQueued(receipt));
        }
        let exists: bool = transaction.query_row(
            "SELECT EXISTS(SELECT 1 FROM main.oddlang_queue_frames_v1
                 WHERE account = ?1 AND room = ?2 AND invocation = ?3 AND initial = 1)",
            params![
                request.scope.account,
                request.scope.room,
                request.invocation_id
            ],
            |row| row.get(0),
        )?;
        let initial = request.kind == RequestKind::Initial;
        match (initial, exists) {
            (true, true) => return Err(QueueError::InvocationCollision),
            (false, false) => return Err(QueueError::MissingInvocation),
            _ => {}
        }
        transaction.execute(
            "INSERT INTO main.oddlang_queue_frames_v1
                 (account, room, request, invocation, initial, digest, frame)
                 VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
            params![
                request.scope.account,
                request.scope.room,
                request.request_id,
                request.invocation_id,
                initial,
                request.digest,
                request.frame
            ],
        )?;
        transaction.commit()?;
        Ok(Enqueued::Queued(receipt))
    }

    pub fn read(
        &self,
        scope: QueueScope,
        request_id: Id,
    ) -> Result<Option<QueuedFrame>, QueueError> {
        self.check_scope(scope)?;
        read(self.connection, scope, request_id)
    }

    fn check_scope(&self, actual: QueueScope) -> Result<(), QueueError> {
        if self.authorized != actual {
            return Err(QueueError::Scope);
        }
        Ok(())
    }
}

fn install_schema(connection: &Connection) -> Result<bool, QueueError> {
    let definitions = [
        (
            "TABLE",
            "oddlang_queue_contract_v1",
            " (only_row INTEGER PRIMARY KEY CHECK (only_row = 1),
                name TEXT NOT NULL, account_bytes INTEGER NOT NULL, room_bytes INTEGER NOT NULL,
                id_bytes INTEGER NOT NULL, max_frame INTEGER NOT NULL) STRICT"
                .to_owned(),
        ),
        (
            "TABLE",
            "oddlang_queue_frames_v1",
            format!(
                " (account BLOB NOT NULL CHECK (length(account) = {ACCOUNT_BYTES}),
                   room BLOB NOT NULL CHECK (length(room) = {ROOM_BYTES}),
                   request BLOB NOT NULL CHECK (length(request) = {ID_BYTES}),
                   invocation BLOB NOT NULL CHECK (length(invocation) = {ID_BYTES}),
                   initial INTEGER NOT NULL CHECK (initial IN (0, 1)),
                   digest BLOB NOT NULL CHECK (length(digest) = 32),
                   frame BLOB NOT NULL CHECK (length(frame) BETWEEN 1 AND {MAX_FRAME_BYTES}),
                   PRIMARY KEY(account, room, request)) STRICT, WITHOUT ROWID"
            ),
        ),
        (
            "UNIQUE INDEX",
            "oddlang_queue_initial_v1",
            " ON oddlang_queue_frames_v1(account, room, invocation) WHERE initial = 1".to_owned(),
        ),
    ];
    let mut missing = Vec::new();
    for (kind, name, definition) in &definitions {
        let stored: Option<String> = connection
            .query_row(
                "SELECT sql FROM main.sqlite_schema WHERE name = ?1 COLLATE NOCASE",
                [name],
                |row| row.get(0),
            )
            .optional()?;
        match stored {
            Some(sql) if sql == format!("CREATE {kind} {name}{definition}") => {}
            Some(_) => return Err(QueueError::Contract),
            None => missing.push(format!("CREATE {kind} main.{name}{definition};")),
        }
    }
    match missing.len() {
        0 => Ok(false),
        count if count == definitions.len() => {
            connection.execute_batch(&missing.concat())?;
            Ok(true)
        }
        _ => Err(QueueError::Contract),
    }
}

fn validate(frame: &[u8], digest: &[u8; 32]) -> Result<(), QueueError> {
    if frame.is_empty() || frame.len() > MAX_FRAME_BYTES as usize {
        return Err(QueueError::Frame);
    }
    if &<[u8; 32]>::from(Sha256::digest(frame)) != digest {
        return Err(QueueError::Digest);
    }
    Ok(())
}

fn read(
    connection: &Connection,
    scope: QueueScope,
    request_id: Id,
) -> Result<Option<QueuedFrame>, QueueError> {
    let row = connection
        .query_row(
            "SELECT invocation, initial, digest,
            CASE WHEN typeof(frame) = 'blob' AND length(frame) BETWEEN 1 AND ?4 THEN frame END
            FROM main.oddlang_queue_frames_v1 WHERE account = ?1 AND room = ?2 AND request = ?3",
            params![scope.account, scope.room, request_id, MAX_FRAME_BYTES],
            |row| {
                Ok((
                    row.get::<_, Id>(0)?,
                    row.get::<_, i64>(1)?,
                    row.get::<_, [u8; 32]>(2)?,
                    row.get::<_, Option<Vec<u8>>>(3)?,
                ))
            },
        )
        .optional()
        .map_err(|error| match error {
            ::rusqlite::Error::FromSqlConversionFailure(..)
            | ::rusqlite::Error::InvalidColumnType(..)
            | ::rusqlite::Error::IntegralValueOutOfRange(..) => QueueError::Corrupt,
            error => error.into(),
        })?;
    row.map(|(invocation_id, initial, digest, frame)| {
        let kind = match initial {
            0 => RequestKind::FollowUp,
            1 => RequestKind::Initial,
            _ => return Err(QueueError::Corrupt),
        };
        let frame = frame.ok_or(QueueError::Corrupt)?;
        validate(&frame, &digest).map_err(|_| QueueError::Corrupt)?;
        let receipt = QueueReceipt {
            scope,
            request_id,
            invocation_id,
            kind,
            digest,
        };
        Ok(QueuedFrame { receipt, frame })
    })
    .transpose()
}
