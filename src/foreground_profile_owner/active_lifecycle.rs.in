
use cgka_traits::TransportAdapter;
use marmot_session::{AccountDeviceRuntime, AccountIdentityProofRequest, AccountIdentityProofSigner,
    SessionConfig, SessionError, StaticTransportRouting};
use nostr::key::SecretKey;
use nostr_sdk::{client::Client, prelude::SignerAuthenticator};
use tokio::{task::JoinHandle, time::{Instant, timeout_at}};
use transport_nostr_adapter::NostrTransportAdapter;
use transport_nostr_peeler::{MarmotNostrSigner, NostrMlsPeeler};

struct AccountSigner(Arc<Keys>);

impl AccountIdentityProofSigner for AccountSigner {
    fn sign_account_identity_proof(&self, request: &AccountIdentityProofRequest) -> Result<[u8; 64], String> {
        if request.account_identity.as_slice() != self.0.public_key().to_bytes() {
            return Err(IDENTITY_MISMATCH.to_owned());
        }
        let event = request.proof_event()?.finalize(self.0.as_ref()).map_err(|_| INVALID_CREDENTIAL.to_owned())?;
        request.signature_from_signed_event(event)
    }
}

struct ActiveProviders {
    runtime: AccountDeviceRuntime<NostrTransportAdapter, StaticTransportRouting, BoundPublisher>,
    journal: rusqlite::Connection,
    storage_closer: storage_sqlite::DatabaseCloser,
    identity: MemberId,
    relay: Arc<NostrSdkRelayClient>,
    adapter: NostrTransportAdapter,
    client: Client,
    connector: OnionConnector,
    stop: watch::Sender<bool>,
    forwarder: Option<JoinHandle<()>>,
}

impl ActiveProviders {
    fn open(root: &Path, profile: &ProfileRecord, endpoint: Url) -> Result<Self, (u8, Failure)> {
        let secret_path = root.join(CREDENTIAL_DIRECTORY);
        let signing = credential(&secret_path, SIGNING_PREFIX, &profile.signing_ref).map_err(|failure| (1, failure))?;
        let secret = credential(&secret_path, DATA_PREFIX, &profile.data_ref).map_err(|failure| (1, failure))?;
        let public = profile.public_key.as_deref().ok_or((1, INVALID_PROFILE))?;
        let keys = Arc::new(Keys::new(SecretKey::from_slice(&signing).map_err(|_| (1, INVALID_CREDENTIAL))?));
        if keys.public_key().to_hex() != public {
            return Err((1, IDENTITY_MISMATCH));
        }
        let key = <&[u8; 32]>::try_from(secret.as_slice()).map_err(|_| (1, INVALID_CREDENTIAL))?;
        let (storage, journal) = open_stores(root, key, public, &profile.device)?;
        let storage_closer = storage.closer();
        let identity = MemberId::new(keys.public_key().to_bytes().to_vec());
        let (stop, stopping) = watch::channel(false);
        let connector = OnionConnector {
            relay: endpoint.clone(),
            tor: Arc::new(tokio::sync::Mutex::new(None)),
            stop: stopping,
        };
        let dial = Duration::from_millis(DIAL_MS);
        let client = Client::builder().websocket_transport(connector.clone())
            .authenticator(SignerAuthenticator::new(keys.as_ref().clone())).connect_timeout(dial).build();
        let signer: Arc<dyn MarmotNostrSigner> = keys.clone();
        let relay = Arc::new(NostrSdkRelayClient::with_account_signer(client.clone(), identity.clone(), signer.clone()));
        let adapter = NostrTransportAdapter::new(relay.clone());
        let endpoint = TransportEndpoint(endpoint.to_string());
        let routing = StaticTransportRouting::new(vec![endpoint.clone()]);
        let publisher = BoundPublisher { keys: keys.clone(), relay: relay.clone(), endpoint };
        let config = SessionConfig::with_storage(storage, Duration::ZERO, identity.as_slice().to_vec(),
            Box::new(NostrMlsPeeler::new().with_welcome_signer_arc(signer)),
        ).account_identity_proof_signer(Arc::new(AccountSigner(keys)))
            .supported_app_components(APPLICATION_COMPONENTS.iter().copied());
        let runtime = AccountDeviceRuntime::open(config, || {
            Ok::<_, SessionError>((adapter.clone(), routing, publisher))
        }).map_err(|_| (1, PROVIDER_OPEN_FAILURE))?;
        Ok(Self { runtime, journal, storage_closer, identity, relay, adapter, client, connector, stop, forwarder: None })
    }

    async fn activate(&mut self, root: &Path) -> Result<(), Failure> {
        let deadline = Instant::now() + Duration::from_millis(ACTIVATION_MS);
        let dial = Duration::from_millis(DIAL_MS);
        timeout_at(deadline, async {
            let tor = bootstrap_onion(root).await?;
            *self.connector.tor.lock().await = Some(tor);
            self.forwarder = Some(self.relay.spawn_notification_forwarder(self.adapter.clone()));
            let url = self.connector.relay.as_str();
            self.client.add_relay(url).reconnect(false).connect_timeout(dial).await.map_err(|_| RELAY_FAILED)?;
            let relay = self.client.relay(url).await.map_err(|_| RELAY_FAILED)?.ok_or(RELAY_FAILED)?;
            let mut connected = false;
            for _ in 0..DIAL_ATTEMPTS {
                let remaining = deadline.saturating_duration_since(Instant::now()).min(dial);
                if remaining.is_zero() { return Err(ACTIVATION_DEADLINE); }
                if relay.try_connect().timeout(remaining).await.is_ok() && relay.status().is_connected() {
                    connected = true;
                    break;
                }
            }
            if !connected { return Err(RELAY_FAILED); }
            self.runtime.republish_key_package().await.map_err(|_| PROVIDER_UNAVAILABLE)?;
            self.runtime.activate_transport(None).await.map_err(|_| RELAY_FAILED)?;
            if self.forwarder.as_ref().is_none_or(|task| task.is_finished()) {
                return Err(RELAY_FAILED);
            }
            Ok(())
        }).await.map_err(|_| ACTIVATION_DEADLINE)?
    }

    async fn stop(self) -> bool {
        let Self { runtime, journal, storage_closer, identity, relay, adapter, client, connector, stop, forwarder } = self;
        let _ = stop.send(true);
        let deadline = Instant::now() + Duration::from_millis(SHUTDOWN_MS);
        let closed = stop_provider_stages(
            deadline,
            async { adapter.deactivate_account(&identity).await.is_ok() },
            async { client.shutdown().await; client.is_shutdown() },
            forwarder,
            relay.shutdown(),
        ).await;
        connector.tor.lock().await.take();
        drop(runtime);
        drop(adapter);
        drop(relay);
        drop(client);
        let storage_closed = storage_closer.close().is_ok() && storage_closer.is_released();
        let journal_closed = journal.close().is_ok();
        closed && storage_closed && journal_closed
    }
}

async fn start(root: &Path, profile: &ProfileRecord, endpoint: Url) -> Result<(), (u8, Failure)> {
    use tokio::signal::unix::{SignalKind, signal};
    let failure = |error| (1, error);
    let mut interrupt = signal(SignalKind::interrupt()).map_err(|_| failure(IO))?;
    let mut terminate = signal(SignalKind::terminate()).map_err(|_| failure(IO))?;
    let mut runtime = RuntimeDirectory::acquire(profile, root).await.map_err(failure)?;
    let mut providers = match ActiveProviders::open(root, profile, endpoint) {
        Ok(providers) => providers,
        Err(error) => {
            runtime.remove_pending = false;
            return Err(error);
        }
    };
    let mut activation_failure = None;
    let outcome = match StatusOwner::bind(&runtime.path.join(SOCKET_FILE)) {
        Ok(owner) => {
            let status = owner.snapshot_publisher();
            owner.serve_until(async {
                let stop = async { tokio::select! { _ = interrupt.recv() => (), _ = terminate.recv() => () } };
                tokio::pin!(stop);
                tokio::select! {
                    _ = &mut stop => (),
                    result = providers.activate(root) => match result {
                        Ok(()) => {
                            if status.publish(PROVIDER_READY).is_err() {
                                activation_failure = Some(CLEANUP);
                            } else {
                                stop.await;
                            }
                        }
                        Err(error) => activation_failure = Some(error),
                    },
                }
            }).await.map_err(|_| CLEANUP)
        }
        Err(_) => Err(IO),
    };
    let provider_stop_complete = providers.stop().await;
    if !provider_stop_complete {
        runtime.remove_pending = false;
    }
    let runtime_cleanup_complete = provider_stop_complete && runtime.remove().is_ok();
    let report = TerminalReport {
        schema: REPORT_VERSION,
        engine_quiesced: ENGINE_STOP.0, engine_stop_complete: ENGINE_STOP.1,
        provider_stop_complete, runtime_cleanup_complete,
    };
    let encoded = serde_json::to_string(&report).map_err(|_| failure(CLEANUP))?;
    writeln!(io::stdout().lock(), "{encoded}").map_err(|_| failure(IO))?;
    outcome.map_err(failure)?;
    if let Some(error) = activation_failure { return Err(failure(error)); }
    if !provider_stop_complete || !runtime_cleanup_complete { return Err(failure(CLEANUP)); }
    Ok(())
}

fn run(matches: &ArgMatches) -> Result<(), (u8, Failure)> {
    let (base, name, backend) = arguments(matches)?;
    let endpoint = onion_relay(matches)?;
    let failure = |error| (1, error);
    let initial = directory(base).map_err(failure)?;
    let canonical = base.canonicalize().map_err(|_| failure(IO))?;
    let resolved = directory(&canonical).map_err(failure)?;
    if (initial.dev(), initial.ino()) != (resolved.dev(), resolved.ino()) {
        return Err(failure(UNSAFE_DIRECTORY));
    }
    let root = canonical.join(name);
    directory(&root).map_err(failure)?;
    let _lease = Lease::acquire(&root.join(LEASE_FILE)).map_err(failure)?;
    let profile = checked_profile(&root, name, backend).map_err(failure)?;
    check_provider(&root, &profile).map_err(failure)?;
    for leaf in EXCLUDED_OWNER_FILES {
        match root.join(leaf).symlink_metadata() {
            Ok(_) => return Err((125, SCOPE)),
            Err(error) if error.kind() == io::ErrorKind::NotFound => (),
            Err(_) => return Err(failure(IO)),
        }
    }
    // The executor also owns any remaining canceled SDK work. Its teardown
    // precedes release of the exclusive lease even when a stop stage times out.
    let executor = tokio::runtime::Builder::new_current_thread().enable_all().build()
        .map_err(|_| failure(IO))?;
    executor.block_on(start(&root, &profile, endpoint))
}
