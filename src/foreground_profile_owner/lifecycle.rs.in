
use cgka_traits::{MemberId, TransportAdapter, TransportEndpoint, maintenance::SignedPublicationArtifact};
use marmot_session::{
    AccountDeviceRuntime, AccountIdentityProofRequest, AccountIdentityProofSigner, KeyPackagePublication,
    KeyPackagePublishError, KeyPackagePublishReceipt, KeyPackagePublisher, SessionConfig,
    SessionError, StaticTransportRouting,
};
use nostr::{key::{Keys, SecretKey}, types::Url};
use nostr_sdk::{
    client::Client, prelude::SignerAuthenticator,
    transport::websocket::{WebSocketSink, WebSocketStream, WebSocketTransport},
};
use tokio::{sync::watch, task::JoinHandle, time::{Instant, timeout_at}};
use transport_nostr_adapter::{NostrSdkRelayClient, NostrTransportAdapter};
use transport_nostr_peeler::{MarmotNostrSigner, NostrMlsPeeler};

struct LocalPublisher;

#[async_trait::async_trait]
impl KeyPackagePublisher for LocalPublisher {
    async fn prepare_key_package(
        &self, _: KeyPackagePublication,
    ) -> Result<SignedPublicationArtifact, KeyPackagePublishError> {
        Err(KeyPackagePublishError::unexposed(PROVIDER_UNAVAILABLE))
    }

    async fn publish_prepared_key_package(
        &self, _: &KeyPackagePublication, _: &SignedPublicationArtifact,
    ) -> Result<KeyPackagePublishReceipt, KeyPackagePublishError> {
        Err(KeyPackagePublishError::unexposed(PROVIDER_UNAVAILABLE))
    }
}

struct ProofSigner(secp256k1::Keypair);

impl Drop for ProofSigner {
    fn drop(&mut self) { self.0.non_secure_erase(); }
}

impl AccountIdentityProofSigner for ProofSigner {
    fn sign_account_identity_proof(&self, request: &AccountIdentityProofRequest) -> Result<[u8; 64], String> {
        let bytes = request.proof_event_id()?;
        Ok(*secp256k1::Secp256k1::new().sign_schnorr_no_aux_rand(&bytes, &self.0).as_ref())
    }
}

#[derive(Clone, Debug)]
struct LocalTlsBoundary {
    endpoint: SocketAddr,
    authorized: Url,
    stop: watch::Receiver<bool>,
    result: Arc<std::sync::Mutex<Option<Failure>>>,
}

impl WebSocketTransport for LocalTlsBoundary {
    fn support_ping(&self) -> bool { false }

    fn connect<'a>(
        &'a self, url: &'a Url, proxy: Option<SocketAddr>,
    ) -> std::pin::Pin<Box<dyn std::future::Future<
        Output = Result<(WebSocketSink, WebSocketStream), nostr_sdk::error::Error>
    > + Send + 'a>> {
        Box::pin(async move {
            let failure = if url != &self.authorized || proxy.is_some() {
                RELAY_SCOPE
            } else {
                let mut stop = self.stop.clone();
                tokio::select! {
                    biased;
                    _ = stop.wait_for(|stopping| *stopping) => RELAY_FAILED,
                    failure = activate(self.endpoint) => failure,
                }
            };
            *self.result.lock().unwrap_or_else(|error| error.into_inner()) = Some(failure);
            Err(nostr_sdk::error::Error::transport(io::Error::other(failure)))
        })
    }
}

type Account = AccountDeviceRuntime<NostrTransportAdapter, StaticTransportRouting, LocalPublisher>;

struct Providers {
    account: Account,
    journal: rusqlite::Connection,
    storage_closer: storage_sqlite::DatabaseCloser,
    identity: MemberId,
    relay: Arc<NostrSdkRelayClient>,
    adapter: NostrTransportAdapter,
    client: Client,
    transport_stop: watch::Sender<bool>,
    transport_result: Arc<std::sync::Mutex<Option<Failure>>>,
    forwarder: Option<JoinHandle<()>>,
    relay_url: String,
}

impl Providers {
    fn open(root: &Path, profile: &ProfileRecord, endpoint: SocketAddr) -> Result<Self, (u8, Failure)> {
        let material = root.join(CREDENTIAL_DIRECTORY);
        let signing = credential(&material, SIGNING_PREFIX, &profile.signing_ref).map_err(|error| (1, error))?;
        let secret = credential(&material, DATA_PREFIX, &profile.data_ref).map_err(|error| (1, error))?;
        let public = profile.public_key.as_deref().ok_or((1, INVALID_PROFILE))?;
        let raw = <&[u8; 32]>::try_from(secret.as_slice()).map_err(|_| (1, INVALID_CREDENTIAL))?;
        let (storage, journal) = open_stores(root, raw, public, &profile.device)?;
        let storage_closer = storage.closer();

        let keys = Arc::new(Keys::new(SecretKey::from_slice(&signing).map_err(|_| (1, INVALID_CREDENTIAL))?));
        let identity = MemberId::new(keys.public_key().to_bytes().to_vec());
        if keys.public_key().to_hex() != public {
            return Err((1, IDENTITY_MISMATCH));
        }
        let mut secret_key = secp256k1::SecretKey::from_slice(&signing).map_err(|_| (1, INVALID_CREDENTIAL))?;
        let proof = ProofSigner(secp256k1::Keypair::from_secret_key(&secp256k1::Secp256k1::new(), &secret_key));
        secret_key.non_secure_erase();
        let (transport_stop, stop) = watch::channel(false);
        let transport_result = Arc::new(std::sync::Mutex::new(None));
        let relay_url = format!("wss://{endpoint}/");
        let authorized = Url::parse(&relay_url).map_err(|_| (1, RELAY_SCOPE))?;
        let transport = LocalTlsBoundary { endpoint, authorized, stop, result: transport_result.clone() };
        let client = Client::builder().websocket_transport(transport)
            .authenticator(SignerAuthenticator::new(keys.as_ref().clone()))
            .connect_timeout(Duration::from_millis(DIAL_MS)).build();
        let signer: Arc<dyn MarmotNostrSigner> = keys;
        let relay = Arc::new(NostrSdkRelayClient::with_account_signer(client.clone(), identity.clone(), signer.clone()));
        let adapter = NostrTransportAdapter::new(relay.clone());
        let routes = StaticTransportRouting::new(vec![TransportEndpoint(relay_url.clone())]);
        let config = SessionConfig::with_storage(
            storage, Duration::ZERO, identity.as_slice().to_vec(),
            Box::new(NostrMlsPeeler::new().with_welcome_signer_arc(signer)),
        ).account_identity_proof_signer(Arc::new(proof));
        let account = AccountDeviceRuntime::open(config, || {
            Ok::<_, SessionError>((adapter.clone(), routes, LocalPublisher))
        }).map_err(|_| (1, PROVIDER_OPEN_FAILURE))?;
        Ok(Self { account, journal, storage_closer, identity, relay, adapter, client, transport_stop, transport_result,
            forwarder: None, relay_url })
    }

    async fn activate(&mut self) -> Failure {
        self.forwarder = Some(self.relay.spawn_notification_forwarder(self.adapter.clone()));
        let deadline = Instant::now() + Duration::from_millis(ACTIVATION_MS);
        let dial = Duration::from_millis(DIAL_MS);
        let result = timeout_at(deadline, async {
            self.client.add_relay(self.relay_url.as_str()).reconnect(false).connect_timeout(dial)
                .await.map_err(|_| RELAY_FAILED)?;
            let relay = self.client.relay(self.relay_url.as_str()).await
                .map_err(|_| RELAY_FAILED)?.ok_or(RELAY_FAILED)?;
            for _ in 0..DIAL_ATTEMPTS {
                let remaining = deadline.saturating_duration_since(Instant::now()).min(dial);
                let _ = relay.try_connect().timeout(remaining).await;
                let observed = *self.transport_result.lock().unwrap_or_else(|error| error.into_inner());
                if let Some(error @ (PROVIDER_UNAVAILABLE | RELAY_SCOPE)) = observed {
                    return Err(error);
                }
            }
            Err::<(), _>(RELAY_FAILED)
        }).await;
        result.unwrap_or(Err(ACTIVATION_DEADLINE)).unwrap_err()
    }

    async fn stop(self) -> bool {
        let Self { account, journal, storage_closer, identity, relay, adapter, client, transport_stop, forwarder, .. } = self;
        let _ = transport_stop.send(true);
        let deadline = Instant::now() + Duration::from_millis(SHUTDOWN_MS);
        let closed = stop_provider_stages(
            deadline,
            async { adapter.deactivate_account(&identity).await.is_ok() },
            async { client.shutdown().await; client.is_shutdown() },
            forwarder,
            relay.shutdown(),
        ).await;
        drop(account);
        drop(adapter);
        drop(relay);
        drop(client);
        let storage_closed = storage_closer.close().is_ok() && storage_closer.is_released();
        let journal_closed = journal.close().is_ok();
        closed && storage_closed && journal_closed
    }
}

async fn start(root: &Path, profile: &ProfileRecord, endpoint: SocketAddr) -> Result<(), (u8, Failure)> {
    use tokio::signal::unix::{SignalKind, signal};
    let failure = |error| (1, error);
    let mut interrupt = signal(SignalKind::interrupt()).map_err(|_| failure(IO))?;
    let mut terminate = signal(SignalKind::terminate()).map_err(|_| failure(IO))?;
    let mut runtime = RuntimeDirectory::acquire(profile, root).await.map_err(failure)?;
    let mut providers = match Providers::open(root, profile, endpoint) {
        Ok(providers) => providers,
        Err(error) => {
            runtime.remove_pending = false;
            return Err(error);
        }
    };
    let mut activation_failure = None;
    let outcome = match StatusOwner::bind(&runtime.path.join(SOCKET_FILE)) {
        Ok(owner) => owner.serve_until(async {
            tokio::select! {
                _ = interrupt.recv() => {},
                _ = terminate.recv() => {},
                error = providers.activate() => activation_failure = Some(error),
            }
        }).await.map_err(|_| CLEANUP),
        Err(_) => Err(IO),
    };
    let provider_stop_complete = providers.stop().await;
    if !provider_stop_complete {
        runtime.remove_pending = false;
    }
    let runtime_cleanup_complete = provider_stop_complete && runtime.remove().is_ok();
    let report = TerminalReport {
        schema: REPORT_VERSION,
        engine_quiesced: ENGINE_STOP.0, engine_stop_complete: ENGINE_STOP.1,
        provider_stop_complete, runtime_cleanup_complete,
    };
    let encoded = serde_json::to_string(&report).map_err(|_| failure(CLEANUP))?;
    writeln!(io::stdout().lock(), "{encoded}").map_err(|_| failure(IO))?;
    outcome.map_err(failure)?;
    if let Some(error) = activation_failure { return Err(failure(error)); }
    if !provider_stop_complete || !runtime_cleanup_complete { return Err(failure(CLEANUP)); }
    Ok(())
}

fn run(matches: &ArgMatches) -> Result<(), (u8, Failure)> {
    let (base, name, backend) = arguments(matches)?;
    let endpoint = relay(matches)?;
    let failure = |error| (1, error);
    let initial = directory(base).map_err(failure)?;
    let canonical = base.canonicalize().map_err(|_| failure(IO))?;
    let resolved = directory(&canonical).map_err(failure)?;
    if (initial.dev(), initial.ino()) != (resolved.dev(), resolved.ino()) {
        return Err(failure(UNSAFE_DIRECTORY));
    }
    let root = canonical.join(name);
    directory(&root).map_err(failure)?;
    let _lease = Lease::acquire(&root.join(LEASE_FILE)).map_err(failure)?;
    let profile = checked_profile(&root, name, backend).map_err(failure)?;
    check_provider(&root, &profile).map_err(failure)?;
    for leaf in EXCLUDED_OWNER_FILES {
        match root.join(leaf).symlink_metadata() {
            Ok(_) => return Err((125, SCOPE)),
            Err(error) if error.kind() == io::ErrorKind::NotFound => (),
            Err(_) => return Err(failure(IO)),
        }
    }
    // The executor also owns any remaining canceled SDK work. Its teardown
    // precedes release of the exclusive lease even when a stop stage times out.
    let executor = tokio::runtime::Builder::new_current_thread().enable_all().build()
        .map_err(|_| failure(IO))?;
    executor.block_on(start(&root, &profile, endpoint))
}
