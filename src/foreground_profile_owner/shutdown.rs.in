
async fn stop_provider_stages(
    deadline: Instant,
    deactivation: impl std::future::Future<Output = bool>,
    client_shutdown: impl std::future::Future<Output = bool>,
    forwarding: Option<JoinHandle<()>>,
    relay_shutdown: impl std::future::Future<Output = ()>,
) -> bool {
    let deactivated = timeout_at(deadline, deactivation).await.unwrap_or(false);
    let client_stopped = timeout_at(deadline, client_shutdown).await.unwrap_or(false);
    let relay_stopped = timeout_at(deadline, relay_shutdown).await.is_ok();
    let task_stopped = if let Some(mut task) = forwarding {
        // The relay sends the terminal notification. A graceful forwarder
        // return includes its native delivery worker's own join.
        if matches!(timeout_at(deadline, &mut task).await, Ok(Ok(()))) {
            true
        } else {
            task.abort();
            false
        }
    } else {
        true
    };
    deactivated && client_stopped && relay_stopped && task_stopped
}
