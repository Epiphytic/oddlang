
use clap::{ArgMatches, parser::ValueSource};
use std::{
    fs::{self, File, OpenOptions}, io::{self, Read, Write},
    os::{fd::AsRawFd, unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt}},
    net::SocketAddr, path::{Path, PathBuf}, process::ExitCode, sync::Arc, time::Duration,
};
use zeroize::Zeroizing;

type Failure = &'static str;

fn uid() -> u32 {
    // SAFETY: geteuid takes no arguments and returns this process's credential.
    unsafe { libc::geteuid() }
}

fn directory(path: &Path) -> Result<fs::Metadata, Failure> {
    let info = fs::symlink_metadata(path).map_err(|_| IO)?;
    if !info.is_dir() || info.uid() != uid() || info.mode() & 0o777 != 0o700 {
        return Err(UNSAFE_DIRECTORY);
    }
    Ok(info)
}

fn owned_file(path: &Path, create: bool, missing: Failure) -> Result<File, Failure> {
    let file = OpenOptions::new().read(true).write(create).create(create).mode(0o600)
        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK)
        .open(path).map_err(|error| match error.kind() {
            io::ErrorKind::NotFound => missing,
            _ if error.raw_os_error() == Some(libc::ELOOP) => UNSAFE_FILE,
            _ => IO,
        })?;
    let info = file.metadata().map_err(|_| IO)?;
    if !info.is_file() || info.uid() != uid() || info.nlink() != 1 || info.mode() & 0o777 != 0o600 {
        return Err(UNSAFE_FILE);
    }
    Ok(file)
}

struct Lease(File);

impl Lease {
    fn acquire(path: &Path) -> Result<Self, Failure> {
        let file = owned_file(path, true, IO)?;
        // SAFETY: file owns a valid descriptor until the returned lease is dropped.
        if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
            return Err(ALREADY_RUNNING);
        }
        Ok(Self(file))
    }
}

impl Drop for Lease {
    fn drop(&mut self) {
        // SAFETY: the descriptor remains live during Drop.
        let _ = unsafe { libc::flock(self.0.as_raw_fd(), libc::LOCK_UN) };
    }
}

fn lower_hex(value: &str, bytes: usize) -> bool {
    value.len() == bytes * 2 && value.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
}

fn checked_profile(root: &Path, name: &str) -> Result<ProfileRecord, Failure> {
    let mut bytes = Vec::new();
    owned_file(&root.join(PROFILE_DOCUMENT), false, MISSING_PROFILE)?
        .take(u64::from(PROFILE_LIMIT) + 1).read_to_end(&mut bytes).map_err(|_| IO)?;
    if bytes.len() > PROFILE_LIMIT as usize {
        return Err(INVALID_PROFILE);
    }
    let profile: ProfileRecord = serde_json::from_slice(&bytes).map_err(|_| INVALID_PROFILE)?;
    if profile.format != PROFILE_FORMAT {
        return Err(INCOMPATIBLE_FORMAT);
    }
    if profile.name != name || !lower_hex(&profile.profile_id, SHORT_ID)
        || !lower_hex(&profile.transaction, SHORT_ID) || !lower_hex(&profile.device, SHORT_ID)
        || !lower_hex(&profile.signing_ref, CREDENTIAL_ID) || !lower_hex(&profile.data_ref, CREDENTIAL_ID)
        || profile.signing_ref == profile.data_ref
        || profile.public_key.as_ref().is_some_and(|key| !lower_hex(key, 32) || key.parse::<secp256k1::XOnlyPublicKey>().is_err())
    {
        return Err(INVALID_PROFILE);
    }
    if profile.phase != READY {
        return Err(NOT_READY);
    }
    if profile.public_key.is_none() {
        return Err(INVALID_PROFILE);
    }
    if profile.backend != BACKEND {
        return Err(BACKEND_MISMATCH);
    }
    Ok(profile)
}

fn credential(root: &Path, prefix: &str, reference: &str) -> Result<Zeroizing<Vec<u8>>, Failure> {
    let mut bytes = Zeroizing::new(Vec::with_capacity(33));
    owned_file(&root.join(format!("{prefix}-{reference}")), false, MISSING_CREDENTIAL)?
        .take(33).read_to_end(&mut bytes).map_err(|_| IO)?;
    if bytes.len() != 32 {
        return Err(INVALID_CREDENTIAL);
    }
    Ok(bytes)
}

fn check_provider(root: &Path, profile: &ProfileRecord) -> Result<(), Failure> {
    let path = root.join(CREDENTIAL_DIRECTORY);
    directory(&path)?;
    let material = credential(&path, SIGNING_PREFIX, &profile.signing_ref)?;
    let mut secret = secp256k1::SecretKey::from_slice(&material).map_err(|_| INVALID_CREDENTIAL)?;
    let mut pair = secp256k1::Keypair::from_secret_key(&secp256k1::Secp256k1::new(), &secret);
    let (public, _) = pair.x_only_public_key();
    pair.non_secure_erase();
    secret.non_secure_erase();
    if profile.public_key.as_deref() != Some(public.to_string().as_str()) {
        return Err(IDENTITY_MISMATCH);
    }
    let _storage = credential(&path, DATA_PREFIX, &profile.data_ref)?;
    Ok(())
}

struct RuntimeDirectory {
    path: PathBuf,
    directory_handle: File,
    binding: Option<File>,
    remove_pending: bool,
}

impl RuntimeDirectory {
    fn acquire(profile: &ProfileRecord, root: &Path) -> Result<Self, Failure> {
        let path = std::env::temp_dir().join(format!("{RUNTIME_PREFIX}-{}-{}", uid(), profile.profile_id));
        if path.as_os_str().as_encoded_bytes().len().saturating_add(RESERVED_PATH) >= MAX_PATH {
            return Err(RUNTIME_LENGTH);
        }
        fs::DirBuilder::new().mode(0o700).create(&path).map_err(|error| {
            if error.kind() == io::ErrorKind::AlreadyExists { RUNTIME_COLLISION } else { IO }
        })?;
        let info = directory(&path)?;
        let handle = OpenOptions::new().read(true)
            .custom_flags(libc::O_NOFOLLOW | libc::O_DIRECTORY | libc::O_CLOEXEC)
            .open(&path).map_err(|_| IO)?;
        let opened = handle.metadata().map_err(|_| IO)?;
        if (info.dev(), info.ino()) != (opened.dev(), opened.ino()) {
            return Err(RUNTIME_COLLISION);
        }
        let mut runtime = Self { path, directory_handle: handle, binding: None, remove_pending: true };
        let expected = RuntimeRecord { format: RUNTIME_FORMAT, profile_id: &profile.profile_id, root };
        let bytes = serde_json::to_vec(&expected).map_err(|_| INVALID_PROFILE)?;
        let binding = OpenOptions::new().write(true).create_new(true).mode(0o600)
            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
            .open(runtime.path.join(BINDING_FILE)).map_err(|_| IO)?;
        runtime.binding = Some(binding);
        let binding = runtime.binding.as_mut().expect("new runtime binding");
        binding.write_all(&bytes).and_then(|()| binding.sync_all()).map_err(|_| IO)?;
        runtime.directory_handle.sync_all().map_err(|_| IO)?;
        Ok(runtime)
    }

    fn remove(&mut self) -> Result<(), Failure> {
        if !std::mem::take(&mut self.remove_pending) {
            return Ok(());
        }
        let owned = self.directory_handle.metadata().map_err(|_| CLEANUP)?;
        let info = match fs::symlink_metadata(&self.path) {
            Ok(info) => info,
            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
            Err(_) => return Err(CLEANUP),
        };
        if !info.is_dir() || (info.dev(), info.ino()) != (owned.dev(), owned.ino()) {
            return Err(CLEANUP);
        }
        if let Some(binding) = self.binding.as_ref() {
            let expected = binding.metadata().map_err(|_| CLEANUP)?;
            let path = self.path.join(BINDING_FILE);
            let meta = fs::symlink_metadata(&path).map_err(|_| CLEANUP)?;
            if !meta.is_file() || (meta.dev(), meta.ino()) != (expected.dev(), expected.ino()) {
                return Err(CLEANUP);
            }
            fs::remove_file(path).map_err(|_| CLEANUP)?;
        }
        fs::remove_dir(&self.path).map_err(|_| CLEANUP)
    }
}

impl Drop for RuntimeDirectory {
    fn drop(&mut self) {
        let _ = self.remove();
    }
}

fn matches_scope(matches: &ArgMatches) -> bool {
    let mut level = matches;
    loop {
        let unsupported = level.ids().any(|id| {
            let name = id.as_str();
            level.value_source(name) == Some(ValueSource::CommandLine)
                // Clap adds typed Id values for synthetic argument groups.
                && level.try_get_one::<clap::Id>(name).ok().flatten().is_none()
                && ![FOREGROUND_ARG, STATE_ARG, IDENTITY_ARG, BACKEND_ARG, ROUTE_ARG, RELAY_ARG].contains(&name)
        });
        if unsupported {
            return false;
        }
        match level.subcommand() {
            Some((_, child)) => level = child,
            None => return true,
        }
    }
}

fn arguments(matches: &ArgMatches) -> Result<(&Path, &str), (u8, Failure)> {
    if !matches.try_get_one::<bool>(FOREGROUND_ARG).ok().flatten().copied().unwrap_or(false)
        || !matches_scope(matches)
    {
        return Err((125, SCOPE));
    }
    let base = matches.try_get_one::<PathBuf>(STATE_ARG).ok().flatten().ok_or((125, SCOPE))?;
    let name = matches.try_get_one::<String>(IDENTITY_ARG).ok().flatten().ok_or((125, SCOPE))?;
    let choice = matches.try_get_one::<String>(BACKEND_ARG).ok().flatten().ok_or((125, SCOPE))?;
    if !BACKEND_CHOICES.contains(&choice.as_str()) {
        return Err((1, BACKEND_MISMATCH));
    }
    if name.is_empty() || name.len() > NAME_LIMIT
        || !name.bytes().all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
    {
        return Err((1, INVALID_NAME));
    }
    Ok((base, name))
}

fn relay(matches: &ArgMatches) -> Result<SocketAddr, (u8, Failure)> {
    let route = matches.try_get_one::<String>(ROUTE_ARG).ok().flatten();
    let mut values = matches.try_get_many::<String>(RELAY_ARG).ok().flatten().ok_or((125, RELAY_SCOPE))?;
    let value = values.next().ok_or((125, RELAY_SCOPE))?;
    if route.is_none_or(|value| value != ROUTE_VALUE) || values.next().is_some() {
        return Err((125, RELAY_SCOPE));
    }
    if value.starts_with("ws://") {
        return Err((1, PLAINTEXT_RELAY));
    }
    let authority = value.strip_prefix("wss://").ok_or((125, RELAY_SCOPE))?;
    let endpoint: SocketAddr = authority.strip_suffix('/').unwrap_or(authority)
        .parse().map_err(|_| (125, RELAY_SCOPE))?;
    if !endpoint.ip().is_loopback() || endpoint.port() == 0 {
        return Err((125, RELAY_SCOPE));
    }
    Ok(endpoint)
}

async fn activate(endpoint: SocketAddr) -> Failure {
    let configure = || {
        let provider = Arc::new(rustls::crypto::ring::default_provider());
        let builder = rustls::ClientConfig::builder_with_provider(provider)
            .with_safe_default_protocol_versions().map_err(|_| RELAY_FAILED)?;
        let roots = rustls::RootCertStore::from_iter(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
        Ok::<_, Failure>(builder.with_root_certificates(roots).with_no_client_auth())
    };
    let config = match configure() {
        Ok(config) => config,
        Err(failure) => return failure,
    };
    let handshake = async {
        let tcp = tokio::net::TcpStream::connect(endpoint).await.map_err(|_| RELAY_FAILED)?;
        let tls = tokio_rustls::TlsConnector::from(Arc::new(config));
        let name = rustls::pki_types::ServerName::IpAddress(endpoint.ip().into());
        tls.connect(name, tcp).await.map_err(|_| RELAY_FAILED)?;
        Ok::<_, Failure>(())
    };
    match tokio::time::timeout(Duration::from_millis(ACTIVATION_MS), handshake).await {
        Ok(Ok(())) => PROVIDER_UNAVAILABLE,
        Ok(Err(failure)) => failure,
        Err(_) => ACTIVATION_DEADLINE,
    }
}

async fn start(base: &Path, name: &str, endpoint: SocketAddr) -> Result<(), Failure> {
    use tokio::signal::unix::{SignalKind, signal};
    let mut interrupt = signal(SignalKind::interrupt()).map_err(|_| IO)?;
    let mut terminate = signal(SignalKind::terminate()).map_err(|_| IO)?;
    let initial = directory(base)?;
    let canonical = base.canonicalize().map_err(|_| IO)?;
    let resolved = directory(&canonical)?;
    if (initial.dev(), initial.ino()) != (resolved.dev(), resolved.ino()) {
        return Err(UNSAFE_DIRECTORY);
    }
    let root = canonical.join(name);
    directory(&root)?;
    let _lease = Lease::acquire(&root.join(LEASE_FILE))?;
    let profile = checked_profile(&root, name)?;
    check_provider(&root, &profile)?;
    let mut runtime = RuntimeDirectory::acquire(&profile, &root)?;
    let owner = StatusOwner::bind(&runtime.path.join(SOCKET_FILE)).map_err(|_| IO)?;
    let mut activation_failure = None;
    let outcome = owner.serve_until(async {
        tokio::select! {
            _ = interrupt.recv() => {},
            _ = terminate.recv() => {},
            failure = activate(endpoint) => activation_failure = Some(failure),
        }
    }).await.map_err(|_| CLEANUP);
    let removed = runtime.remove();
    outcome.and(removed).and(activation_failure.map_or(Ok(()), Err))
}

fn run(matches: &ArgMatches) -> Result<(), (u8, Failure)> {
    let (base, name) = arguments(matches)?;
    let endpoint = relay(matches)?;
    tokio::runtime::Builder::new_current_thread().enable_all().build()
        .map_err(|_| (1, IO))?
        .block_on(start(base, name, endpoint)).map_err(|error| (1, error))
}
