(version 1)
(allow default)
(deny network*)
(allow network* (subpath (param "WORK")))
(deny file-write*)
(allow file-write* (subpath (param "WORK")) (literal "/dev/null") (literal "/dev/tty"))
(deny file-read-data (subpath (param "PERSONAL")))
(allow file-read-data (literal (param "PERSONAL")) (subpath (param "UV_CACHE"))
    (subpath (param "CARGO_REGISTRY")) (subpath (param "CARGO_GIT"))
    (subpath (param "TOOLCHAIN")) (subpath (param "PYTHON")) (literal (param "UV"))
    (subpath (param "WORK")))
(deny mach-lookup (global-name-prefix "com.apple.securityd")
    (global-name-prefix "com.apple.security.agent") (global-name "com.apple.SecurityServer"))
