{
  "format": "oddlang-local-status-owner-v1",
  "request": {"key": "action", "value": "inspect"},
  "reply": {"ok": "valid", "result": "reading", "error": "problem", "state": "phase", "invalid_request": "unrecognized sample"},
  "listener": {
    "framing": "u32_be_json_half_close", "peer": "same_effective_uid",
    "maximum_frame_bytes": 128, "maximum_clients": 2, "maximum_path_bytes_exclusive": 104,
    "read_deadline_ms": 600, "write_deadline_ms": 250, "accept_retry_ms": 10
  },
  "lifecycle": {
    "bound": "calibrating", "stopping": "closed",
    "transitions": [
      {"from": "calibrating", "to": "recording"},
      {"from": "recording", "to": "calibrating"}
    ]
  },
  "diagnostics": {
    "io": "gauge I/O", "private_parent": "gauge directory is not private", "path": "invalid gauge path",
    "occupied": "gauge endpoint occupied", "invalid_transition": "invalid gauge transition", "cleanup": "gauge cleanup failed"
  }
}
