@prefix l: <urn:oddlang:ledger:> .
@prefix o: <urn:oddlang:core:> .
l:Sql o:imports "fields.ttl" .
l:Sql a o:Projection ; o:target o:Sql ; o:projects l:Account ; o:name "accounts" .
l:Sql o:mapping [ o:field l:id ; o:name "id" ] .
l:Sql o:mapping [ o:field l:owner ; o:name "owner" ] .
l:Sql o:mapping [ o:field l:balance ; o:name "balance" ] .
