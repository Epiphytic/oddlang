@prefix l: <urn:oddlang:ledger:> .
@prefix o: <urn:oddlang:core:> .
l:Avro o:imports "fields.ttl" .
l:Avro a o:Projection ; o:target o:Avro ; o:projects l:Account ; o:name "Account" .
l:Avro o:mapping [ o:field l:id ; o:name "id" ] .
l:Avro o:mapping [ o:field l:owner ; o:name "ownerName" ; o:alias "owner" ] .
l:Avro o:mapping [ o:field l:balance ; o:name "balance" ] .
l:Avro o:mapping [ o:field l:currencyCode ; o:name "currencyCode" ] .
