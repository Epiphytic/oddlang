    p:dependsOn w:portableRustBoundary ;
    p:acceptance "Independently reconcile all selected declarations and relationship endpoints and detect a missing item and a misdirected edge." .

w:portableRustSemantics a p:Task ; rdfs:label "Recover processing and interaction contracts" ;
    p:milestone w:marmishMilestone ; p:source w:portableRustPlan ; p:status p:active ; p:evidence w:portableDataRole ;
