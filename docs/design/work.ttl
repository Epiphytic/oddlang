    p:location "companion:verification/whole/status/file-profile-macos-arm64.json" .
w:nativeFileProfileWitnessReview a p:Finding ;
    rdfs:label "Witness pending resumption, filesystem rejections, exclusive leases and independent identity derivation" ;
    p:source w:nativeFileProfileFixture .
w:nativeFileProfilePreparation p:addresses w:nativeFileProfileWitnessReview .
w:nativeFileProfilePlan a p:Artifact ;
    p:location "docs/superpowers/plans/2026-11-26-native-file-profile.md" .
w:nativeFileProfileFixture a p:Artifact ;
    p:location "verification/file-profile/check.py" .
w:nativeFileProfileStores a p:Task ;
