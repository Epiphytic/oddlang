@prefix w: <urn:oddlang:work:> .
@prefix p: <urn:oddlang:process:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

w:chat a p:Artifact ; rdfs:label "Ontology-Driven Programming Language Concept, original Gemini conversation (local export)" ;
    p:location "Ontology-Driven Programming L…uage Concept - Google Gemini.pdf" .
w:spec a p:Artifact ; p:location "docs/superpowers/specs/2026-11-25-ledger.md" .
w:plan a p:Artifact ; p:location "docs/superpowers/plans/2026-11-25-ledger.md" .
w:review a p:Artifact ; rdfs:label "Fable design review, fourteen findings supplied in the design conversation" .
w:initialCommit a p:Artifact ; p:location <https://github.com/Epiphytic/oddlang/commit/91cb2f3> .
w:rustCommit a p:Artifact ; p:location <https://github.com/Epiphytic/oddlang/commit/31b41cb> .
w:reviewCommit a p:Artifact ; p:location <https://github.com/Epiphytic/oddlang/commit/27ebf94> .
w:guide a p:Artifact ; p:location "AGENTS.md" .
w:processSchema a p:Artifact ; p:location "docs/design/process.ttl" .
w:workGraph a p:Artifact ; p:location "docs/design/work.ttl" .

w:vision a p:Goal ; rdfs:label "Compile a hierarchy of domain, behavior and target ontologies into deterministic native code and data contracts" ; p:source w:chat .
w:structure a p:Goal ; rdfs:label "Generate matching checked Rust and SQL representations and measure graph impact analysis" ; p:source w:spec .
w:behavior a p:Goal ; rdfs:label "Preserve executable transfer semantics across interpretation and Rust generation" ; p:source w:spec .
w:evolution a p:Goal ; rdfs:label "Evolve stored rows and binary events while preserving identity and checked values" ; p:source w:spec .

w:design a p:Milestone ; rdfs:label "Concept, design and review" ; p:advances w:vision .
w:m1 a p:Milestone ; rdfs:label "Compile and inspect the domain" ; p:advances w:structure .
w:contract a p:Milestone ; rdfs:label "Language contract before execution" ; p:advances w:behavior .
w:m2 a p:Milestone ; rdfs:label "Interpret and compile the transfer" ; p:advances w:behavior .
w:m3 a p:Milestone ; rdfs:label "Evolve the table and wire format" ; p:advances w:evolution .

w:rust a p:Decision ; rdfs:label "Use Rust throughout the implementation" ; p:reason "The project author selected Rust." ; p:source w:rustCommit .
w:loader a p:Decision ; rdfs:label "Defer SHACL and validate the closed vocabulary in the typed loader" ; p:reason "One structural validator suffices for the prototype." ; p:source w:reviewCommit .
w:rdfTrial a p:Decision ; rdfs:label "Evaluate Turtle against stable-ID TOML" ; p:reason "Retain Turtle if the import-impact workload removes duplicate declarations or bespoke traversal." ; p:source w:spec .
w:future a p:Decision ; rdfs:label "Revisit surface syntax, additional execution targets and AI-assisted authoring after the ledger experiments" ; p:reason "First establish deterministic execution and evolution across real targets." ; p:source w:chat, w:spec .

w:scope a p:Task ; rdfs:label "Evaluate the concept and select three demonstrations" ; p:milestone w:design ; p:status p:done ; p:source w:chat ; p:evidence w:initialCommit .
w:selectRust a p:Task ; rdfs:label "Record the Rust implementation choice" ; p:milestone w:design ; p:status p:done ; p:dependsOn w:scope ; p:evidence w:rustCommit .
w:revise a p:Task ; rdfs:label "Revise the design and plan after review" ; p:milestone w:design ; p:status p:done ; p:dependsOn w:selectRust ; p:source w:review ; p:evidence w:reviewCommit .
w:track a p:Task ; rdfs:label "Establish the design ontology and contributor guide" ; p:milestone w:design ; p:status p:done ; p:dependsOn w:revise ; p:evidence w:guide, w:processSchema, w:workGraph .

w:review1 a p:Finding ; rdfs:label "Missing normative language contract" ; p:source w:review .

w:review2 a p:Finding ; rdfs:label "Shared loader can hide common errors" ; p:source w:review .

w:review3 a p:Finding ; rdfs:label "Value of RDF untested" ; p:source w:review .

w:review4 a p:Finding ; rdfs:label "Incomplete SQL migration" ; p:source w:review .

w:review5 a p:Finding ; rdfs:label "Scope of CAD default" ; p:source w:review .

w:review6 a p:Finding ; rdfs:label "Undefined transfer state and arguments" ; p:source w:review .

w:review7 a p:Finding ; rdfs:label "Blank-node identity and guard ordering" ; p:source w:review .

w:review8 a p:Finding ; rdfs:label "Avro can carry invalid balances" ; p:source w:review .

w:review9 a p:Finding ; rdfs:label "No cross-target round trip" ; p:source w:review .

w:review10 a p:Finding ; rdfs:label "Unrepresentable boundary inputs" ; p:source w:review .

w:review11 a p:Finding ; rdfs:label "Duplicated validation and uncertain SHACL dependency" ; p:source w:review .

w:review12 a p:Finding ; rdfs:label "Unspecified database provisioning" ; p:source w:review .

w:review13 a p:Finding ; rdfs:label "Schema verdict conflated with one event read" ; p:source w:review .

w:review14 a p:Finding ; rdfs:label "Wire rename and aliases untested" ; p:source w:review .

w:db a p:Task ; rdfs:label "Provision the integration environment" ;
    p:milestone w:m1 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:revise ; p:addresses w:review12 ;
    p:acceptance "Pinned PostgreSQL works offline and missing configuration fails loudly." ; p:evidence w:databaseEvidence .

w:load a p:Task ; rdfs:label "Load and validate" ;
    p:milestone w:m1 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:revise ; p:addresses w:review7, w:review11 ;
    p:acceptance "Invalid declarations fail and equivalent graphs yield identical models and diagnostics." ; p:evidence w:milestone1Evidence .

w:impact a p:Task ; rdfs:label "Measure the graph's contribution" ;
    p:milestone w:m1 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:load ; p:addresses w:review3 ;
    p:acceptance "Query the affected IRIs across imports and record the TOML comparison." ; p:evidence w:milestone1Evidence .

w:emit a p:Task ; rdfs:label "Emit Rust and SQL" ;
    p:milestone w:m1 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:db, w:load ; p:addresses w:review10 ;
    p:acceptance "Rust and SQL agree at both bounds and one step beyond each bound." ; p:evidence w:milestone1Evidence .

w:rules a p:Task ; rdfs:label "Publish the closed vocabulary and evaluation rules" ;
    p:milestone w:contract ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:load ; p:addresses w:review1, w:review6, w:review7 ;
    p:acceptance "Publish the vocabulary, lowering fixture, guard order and state transition rules." ; p:evidence w:languageEvidence .

w:oracle a p:Task ; rdfs:label "Build the oracle first" ;
    p:milestone w:m2 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:rules ; p:addresses w:review2, w:review6 ;
    p:acceptance "Derive whole-state results and first errors from the design without production code." ; p:evidence w:milestone2Evidence .

w:execute a p:Task ; rdfs:label "Build the two execution paths" ;
    p:milestone w:m2 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:oracle, w:emit ; p:addresses w:review1, w:review2 ;
    p:acceptance "Both engines match the oracle and a mutated program exposes shared errors." ; p:evidence w:milestone2Evidence .

w:differential a p:Task ; rdfs:label "Run boundary-weighted differential tests" ;
    p:milestone w:m2 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:execute ; p:addresses w:review2 ;
    p:acceptance "Run at least 10,000 reproducible boundary-weighted cases." ; p:evidence w:milestone2Evidence .

w:roundTrip a p:Task ; rdfs:label "Prove the v1 round trip" ;
    p:milestone w:m3 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:emit ; p:addresses w:review8, w:review9 ;
    p:acceptance "Round-trip the persisted Rust account through Avro and reject a negative balance." ; p:evidence w:milestone3Evidence .

w:migrate a p:Task ; rdfs:label "Migrate the populated table" ;
    p:milestone w:m3 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:roundTrip ; p:addresses w:review4, w:review5 ;
    p:acceptance "Preserve existing rows, backfill CAD and match fresh v2 DDL with no retained default." ; p:evidence w:milestone3Evidence .

w:wire a p:Task ; rdfs:label "Derive and verify wire compatibility" ;
    p:milestone w:m3 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:migrate ; p:addresses w:review5, w:review8, w:review13, w:review14 ;
    p:acceptance "Derive the verdict from the diff and confirm field alias and default handling with binary data." ; p:evidence w:milestone3Evidence .

w:demo a p:Task ; rdfs:label "Run the demo" ;
    p:milestone w:m3 ; p:status p:done ; p:source w:plan ;
    p:dependsOn w:impact, w:differential, w:wire ; p:addresses w:review9 ;
    p:acceptance "Run the offline suite and demo against the pinned database." ; p:evidence w:milestone3Evidence .

w:priorArt a p:Task ; rdfs:label "Survey active ontology compilers before implementing the ledger" ;
    p:milestone w:design ; p:status p:done ; p:dependsOn w:track ;
    p:acceptance "Identify dated upstream activity and compare its scope with the ledger experiments." ;
    p:evidence w:hydraResearch, w:ggenResearch, w:linkmlResearch ;
    rdfs:comment "2026-11-25. A last30days scan surfaced adjacent ontology platforms. Direct repository checks found active overlap in graph programming, RDF-driven generation and schema compilation. The combined transfer-oracle and SQL/Avro migration witness remains unverified in these projects." .

w:hydraResearch a p:Artifact ; rdfs:label "Hydra graph programming and cross-host bootstrap matrix, November 25" ;
    p:location <https://github.com/CategoricalData/hydra/commit/46e6b4c1db791ff2a360c1da50571c9659825c84> .
w:ggenResearch a p:Artifact ; rdfs:label "ggen RDF-driven generator, November 20 repository snapshot" ;
    p:location <https://github.com/seanchatmangpt/ggen/tree/d173cad5792e837bd4fec730d120c582b9bc5d4c> .
w:linkmlResearch a p:Artifact ; rdfs:label "LinkML Rust generator update, November 23" ;
    p:location <https://github.com/linkml/linkml/commit/638684016db14546a3028b78c29e987264502026> .

w:interop a p:Goal ; rdfs:label "Share versioned schemas and API contracts across languages, repositories and organizations" ; p:source w:spec .
w:adoption a p:Milestone ; rdfs:label "Verify coordinated and independent adoption" ; p:advances w:interop .
w:contractPortability a p:Decision ; rdfs:label "Publish immutable contracts and keep each implementation native" ;
    p:reason "A client, CLI, database and service can implement different roles and verify their obligations with portable vectors." ; p:source w:spec .
w:projectionCredit a p:Decision ; rdfs:label "Use reusable target mappings for routine projections, inspired by ggen" ;
    p:reason "A change to a shared declaration should propagate to every affected structural artifact." ; p:source w:ggenResearch, w:spec .
w:lockPolicy a p:Decision ; rdfs:label "Pin contracts per workspace and optionally lock reviewed native adapters" ;
    p:reason "Independent consumers control upgrades and can reproduce accepted source offline." ; p:source w:spec .
w:interopDesign a p:Task ; rdfs:label "Record the contract interoperability design and ggen attribution" ;
    p:milestone w:design ; p:status p:done ; p:dependsOn w:priorArt ; p:source w:ggenResearch ;
    p:acceptance "Align the plan, design and work graph on the two ownership models." ; p:evidence w:plan, w:spec, w:workGraph .
w:release a p:Task ; rdfs:label "Package and pin contract releases" ;
    p:milestone w:adoption ; p:status p:done ; p:source w:plan ; p:dependsOn w:interopDesign, w:oracle, w:wire ;
    p:acceptance "Resolve a release and transitive imports offline, verify content digests and publish portable wire vectors." ; p:evidence w:interoperabilityEvidence .
w:monorepo a p:Task ; rdfs:label "Verify one coordinated monorepo upgrade" ;
    p:milestone w:adoption ; p:status p:done ; p:source w:plan ; p:dependsOn w:release ;
    p:acceptance "One pin upgrades Rust, TypeScript, SQL and Avro projections and their integration checks pass." ; p:evidence w:interoperabilityEvidence .
w:externalClient a p:Task ; rdfs:label "Verify independent contract adoption" ;
    p:milestone w:adoption ; p:status p:done ; p:source w:plan ; p:dependsOn w:release ;
    p:acceptance "A standalone Go client verifies two separately pinned releases with published vectors and replays a reviewed adapter offline." ; p:evidence w:interoperabilityEvidence .

w:databaseEvidence a p:Artifact ; p:location "docs/design/implementation-evidence.md" .

w:milestone1Evidence a p:Artifact ; p:location "docs/design/implementation-evidence.md" .

w:impactComparison a p:Artifact ; p:location "docs/design/impact-comparison.md" .
w:retainTurtle a p:Decision ; rdfs:label "Retain Turtle for the ledger prototype following the impact experiment" ;
    p:reason "Both fixtures avoid duplicate edges. The SPARQL property path replaces the application-maintained traversal loop for the workload." ;
    p:source w:impactComparison .

w:languageEvidence a p:Artifact ; p:location "docs/design/implementation-evidence.md" .

w:milestone2Evidence a p:Artifact ; p:location "docs/design/implementation-evidence.md" .

w:milestone3Evidence a p:Artifact ; p:location "docs/design/implementation-evidence.md" .

w:interoperabilityEvidence a p:Artifact ; p:location "docs/design/implementation-evidence.md" .

w:conformanceDiscussion a p:Artifact ;
    rdfs:label "Project author direction on built-in conformance, HTTP first and continuous ontology maintenance" .

w:portableConformance a p:Goal ;
    rdfs:label "Make deterministic conformance testing intrinsic to each published contract" ;
    p:source w:conformanceDiscussion .

w:roleConformance a p:Decision ;
    rdfs:label "Derive conformance obligations from normative declarations and declared implementation roles" ;
    p:reason "The pinned contract and conformance rules determine each role's obligations. Publish language-neutral cases with expectations grounded in the contract or an independent oracle. When a case cannot be derived, use an author-supplied portable scenario or report the obligation as uncovered. Report results by release, stable declaration IRI and role so changes can trigger the affected checks." ;
    p:source w:conformanceDiscussion .

w:httpFirst a p:Decision ;
    rdfs:label "Exercise the shared conformance model over HTTP first" ;
    p:reason "HTTP is the first practical binding for native services and web clients. Further protocol bindings use the same obligation model with their own ways to exercise and observe cases." ;
    p:source w:conformanceDiscussion .

w:libraryHints a p:Decision ;
    rdfs:label "Keep language, framework and library hints in project-owned target overlays" ;
    p:reason "Target overlays guide native adapter generation and authoring. Independent Rust, TypeScript and Go implementations can use their own libraries and test runners against the same contract cases and expected outcomes for the roles they declare." ;
    p:source w:conformanceDiscussion .

w:continuousOntologyMaintenance a p:Decision ;
    rdfs:label "Require LLMs and other coding agents to update the work ontology with every project change" ;
    p:reason "Recording features, fixes, refactors, documentation, tests, configuration and status changes alongside their work keeps decisions, dependencies and evidence current." ;
    p:source w:conformanceDiscussion .

w:recordConformanceDesign a p:Task ;
    rdfs:label "Record conformance-first design and the agent ontology maintenance requirement" ;
    p:milestone w:design ; p:advances w:portableConformance ; p:status p:done ;
    p:source w:conformanceDiscussion ; p:dependsOn w:interopDesign ;
    p:acceptance "AGENTS.md and the work graph record deterministic role-based conformance, HTTP as the first protocol and the requirement to update the work ontology with every project change." ;
    p:evidence w:guide, w:workGraph .

w:httpSpec a p:Artifact ; rdfs:label "Portable HTTP conformance design" ;
    p:location "docs/superpowers/specs/2026-11-25-http-conformance.md" .
w:httpPlan a p:Artifact ; rdfs:label "Portable HTTP conformance implementation plan" ;
    p:location "docs/superpowers/plans/2026-11-25-http-conformance.md" .

w:httpFoundation a p:Milestone ; rdfs:label "Publish portable HTTP contracts and conformance cases" ;
    p:advances w:portableConformance .
w:httpNative a p:Milestone ; rdfs:label "Verify native HTTP providers and consumers" ;
    p:advances w:portableConformance .
w:httpAdoption a p:Milestone ; rdfs:label "Exercise mixed-stack HTTP adoption and pin changes" ;
    p:advances w:portableConformance, w:interop .

w:httpPlanReview a p:Task ; rdfs:label "Write and independently review the HTTP implementation plan" ;
    p:milestone w:httpFoundation ; p:status p:done ; p:source w:conformanceDiscussion ;
    p:evidence w:httpPlan, w:httpSpec, w:httpClaudeReview ;
    p:dependsOn w:recordConformanceDesign, w:externalClient ;
    p:acceptance "Review a phased plan with Claude CLI and record the disposition of material findings." .

w:httpVocabulary a p:Task ; rdfs:label "Specify and load the HTTP vocabulary" ;
    p:milestone w:httpFoundation ; p:status p:done ; p:source w:httpPlan ;
    p:dependsOn w:httpPlanReview ;
    p:acceptance "Load a closed stable-IRI HTTP profile with pinned ledger semantics offline and reject invalid declarations and imports." .
w:httpBundle a p:Task ; rdfs:label "Publish portable obligations, cases and schemas" ;
    p:milestone w:httpFoundation ; p:status p:done ; p:source w:httpPlan ;
    p:dependsOn w:httpVocabulary ;
    p:acceptance "Publish deterministic evidence requirements, portable cases, OpenAPI and JSON Schema and reject missing required witnesses." .
w:httpProvider a p:Task ; rdfs:label "Prove conformance of a real Rust HTTP provider" ;
    p:milestone w:httpNative ; p:status p:done ; p:source w:httpPlan ;
    p:dependsOn w:httpBundle ;
    p:acceptance "Exercise wire validation, ledger errors and isolated state transitions against a live Rust service and catch a state mutation." .
w:httpConsumers a p:Task ; rdfs:label "Verify TypeScript and independent Go consumers" ;
    p:milestone w:httpNative ; p:status p:done ; p:source w:httpPlan ;
    p:dependsOn w:httpProvider ;
    p:acceptance "Run native client checks against a scripted peer and detect mutated codecs using shared cases and evidence." .
w:httpEvolution a p:Task ; rdfs:label "Expand the JSON profile and verify release evolution" ;
    p:milestone w:httpAdoption ; p:status p:done ; p:source w:httpPlan ;
    p:dependsOn w:httpConsumers ;
    p:acceptance "Verify expanded codecs, both directions of version skew, reproducible pins, and impact tracking by declaration IRI." .
w:httpHybrid a p:Task ; rdfs:label "Exercise Node SSR and browser React against Rust" ;
    p:milestone w:httpAdoption ; p:status p:done ; p:source w:httpPlan ;
    p:dependsOn w:httpEvolution ;
    p:acceptance "Change one workspace pin to update both apps and preserve independent Go adoption in the offline verification matrix." .

w:httpClaudeReview a p:Artifact ; rdfs:label "Claude CLI HTTP implementation plan review and dispositions" ;
    p:location "docs/design/http-plan-review.md" .
w:httpReviewBindings a p:Finding ; rdfs:label "Missing overlay and target lock interfaces" ; p:source w:httpClaudeReview .
w:httpReviewEvidence a p:Finding ; rdfs:label "Missing claim and evidence interfaces" ; p:source w:httpClaudeReview .
w:httpReviewRuleIdentity a p:Finding ; rdfs:label "Incomplete obligation identity and rule versioning" ; p:source w:httpClaudeReview .
w:httpReviewEvolution a p:Finding ; rdfs:label "Unpinned request semantics and overlapping evolution fixtures" ; p:source w:httpClaudeReview .
w:httpReviewPublish a p:Finding ; rdfs:label "Ambiguous source and release loading inputs" ; p:source w:httpClaudeReview .

w:httpPlanReview p:addresses w:httpReviewBindings, w:httpReviewEvidence, w:httpReviewRuleIdentity, w:httpReviewEvolution, w:httpReviewPublish .

w:httpReviewWitnesses a p:Finding ; rdfs:label "Coverage gate lacked a test seam and complete guard witnesses" ; p:source w:httpClaudeReview .
w:httpReviewReproducibility a p:Finding ; rdfs:label "New rules could invalidate evidence for published v1" ; p:source w:httpClaudeReview .
w:httpReviewWire a p:Finding ; rdfs:label "Native parser and URL behavior diverged and harness setup was implicit" ; p:source w:httpClaudeReview .
w:httpReviewSkew a p:Finding ; rdfs:label "A mixed-version transfer can commit before response decoding fails" ; p:source w:httpClaudeReview .
w:httpReviewPhases a p:Finding ; rdfs:label "Richer codecs need a review gate independent of wire migration" ; p:source w:httpClaudeReview .

w:httpPlanReview p:addresses w:httpReviewWitnesses, w:httpReviewReproducibility, w:httpReviewWire, w:httpReviewSkew, w:httpReviewPhases .

w:httpReviewInputs a p:Finding ; rdfs:label "Authored scenario source, stable field names and client overlays needed explicit ownership" ;
    p:source w:httpClaudeReview .
w:httpPlanReview p:addresses w:httpReviewInputs .

w:httpPhase1ReviewFinding a p:Finding ; rdfs:label "Strengthen HTTP loader diagnostics, negative tests and tool pin verification" ;
    p:source w:httpImplementationEvidence .
w:httpVocabulary p:addresses w:httpPhase1ReviewFinding .

w:httpImplementationEvidence a p:Artifact ; rdfs:label "HTTP implementation verification and Claude phase reviews" ;
    p:location "docs/design/http-implementation-evidence.md" .
w:httpVocabulary p:evidence w:httpImplementationEvidence .

w:httpPhase2ReviewFinding a p:Finding ; rdfs:label "Add provider route, decimal and media rejection witnesses" ;
    p:source w:httpImplementationEvidence .
w:httpBundle p:addresses w:httpPhase2ReviewFinding .
w:httpBundle p:evidence w:httpImplementationEvidence .

w:httpPhase3ReviewFinding a p:Finding ; rdfs:label "Bound the example provider request-body buffer" ;
    p:source w:httpImplementationEvidence .
w:httpProvider p:addresses w:httpPhase3ReviewFinding .
w:httpProvider p:evidence w:httpImplementationEvidence .

w:httpPhase4ReviewFinding a p:Finding ; rdfs:label "Verify Fetch in Chromium and align native URL, peer and media handling" ;
    p:source w:httpImplementationEvidence .
w:httpConsumers p:addresses w:httpPhase4ReviewFinding .
w:httpConsumers p:evidence w:httpImplementationEvidence .

w:httpPhase5ReviewFinding a p:Finding ; rdfs:label "Complete codec raw-byte witnesses and pin closed-record validation" ;
    p:source w:httpImplementationEvidence .
w:httpEvolution p:addresses w:httpPhase5ReviewFinding .

w:httpPhase6ReviewFinding a p:Finding ; rdfs:label "Document hybrid roles and check prerequisites and evidence freshness" ;
    p:source w:httpImplementationEvidence .
w:httpHybrid p:addresses w:httpPhase6ReviewFinding .
w:httpEvolution p:evidence w:httpImplementationEvidence .
w:httpHybrid p:evidence w:httpImplementationEvidence .

w:roundTripPlan a p:Artifact ; rdfs:label "WebAssembly, Rust import and Marmish implementation plan" ;
    p:location "docs/superpowers/plans/2026-11-25-wasm-rust-marmish.md" .
w:roundTripReview a p:Artifact ; rdfs:label "Claude plan review and dispositions" ;
    p:location "docs/design/wasm-rust-marmish-plan-review.md" .
w:marmishSource a p:Artifact ; rdfs:label "Pinned Marmish source and qualification history" ;
    p:location "https://github.com/Epiphytic/marmish/tree/49fc705408a230bd0ad896248d08dbdd2faad05a" .
w:roundTripGoal a p:Goal ; rdfs:label "Recover editable contracts and validate native and component implementations" .
w:componentMilestone a p:Milestone ; rdfs:label "Publish and exercise WebAssembly component contracts" ; p:advances w:roundTripGoal, w:portableConformance .
w:rustImportMilestone a p:Milestone ; rdfs:label "Validate deterministic Rust translation" ; p:advances w:roundTripGoal .
w:marmishMilestone a p:Milestone ; rdfs:label "Quantify regeneration and compatibility on pinned Marmish" ; p:advances w:roundTripGoal .
w:roundTripPlanning a p:Task ; rdfs:label "Write and review the seven-phase implementation plan" ;
    p:status p:done ; p:evidence w:roundTripReview, w:roundTripPlan ; p:source w:roundTripPlan ; p:milestone w:componentMilestone ; p:dependsOn w:httpHybrid ;
    p:acceptance "Analyze pinned Marmish, specify executable phase gates and resolve material Claude plan findings." .

w:witPublication a p:Task ; rdfs:label "Publish locked component contracts" ;
    p:milestone w:componentMilestone ; p:status p:done ; p:source w:roundTripPlan ; p:dependsOn w:roundTripPlanning ;
    p:acceptance "Validate canonical WIT projections, pinning and typed rejection cases." .

w:componentExecution a p:Task ; rdfs:label "Exercise guest and host roles" ;
    p:milestone w:componentMilestone ; p:status p:active ; p:source w:roundTripPlan ; p:dependsOn w:witPublication ;
    p:acceptance "Verify real component calls, independent cases, directional evolution and mutation detection." .

w:rustRecovery a p:Task ; rdfs:label "Import supported Rust into editable Oddlang" ;
    p:milestone w:rustImportMilestone ; p:status p:planned ; p:source w:roundTripPlan ; p:dependsOn w:componentExecution ;
    p:acceptance "Compile a regenerated ledger from a deterministic import with explicit identities and fail-closed diagnostics." .

w:rustValidation a p:Task ; rdfs:label "Validate original and regenerated ledger behavior" ;
    p:milestone w:rustImportMilestone ; p:status p:planned ; p:source w:roundTripPlan ; p:dependsOn w:rustRecovery ;
    p:acceptance "Record proof scope, independent differential results and a concrete mutant counterexample." .

w:marmishInventory a p:Task ; rdfs:label "Freeze Marmish baseline and inventory" ;
    p:milestone w:marmishMilestone ; p:status p:planned ; p:source w:roundTripPlan, w:marmishSource ; p:dependsOn w:rustValidation ;
    p:acceptance "Inventory every upstream target and native boundary with a reproducible baseline and gap register." .

w:marmishFeatures a p:Task ; rdfs:label "Implement reusable Oddlang features required by Marmish" ;
    p:milestone w:marmishMilestone ; p:status p:planned ; p:source w:roundTripPlan, w:marmishSource ; p:dependsOn w:marmishInventory ;
    p:acceptance "Exercise inventory-driven compiler and conformance extensions with independent positive and negative fixtures." .

w:marmishQualification a p:Task ; rdfs:label "Rebuild and qualify pinned Marmish" ;
    p:milestone w:marmishMilestone ; p:status p:planned ; p:source w:roundTripPlan, w:marmishSource ; p:dependsOn w:marmishFeatures ;
    p:acceptance "Report fresh native and regenerated build comparisons, preserved native code, coverage, proof scope and remaining gaps." .

w:roundTripBoundaries a p:Finding ; rdfs:label "Separate toolchains, production worlds and independent runtime evidence" ; p:source w:roundTripReview .
w:roundTripAssembly a p:Finding ; rdfs:label "Specify grammar extensions, workspace assembly and generated-source provenance" ; p:source w:roundTripReview .
w:roundTripClaims a p:Finding ; rdfs:label "Require directional witnesses and target-specific qualification evidence" ; p:source w:roundTripReview .
w:roundTripPlanning p:addresses w:roundTripBoundaries, w:roundTripAssembly, w:roundTripClaims .
w:componentExecution p:addresses w:roundTripBoundaries .
w:marmishFeatures p:addresses w:roundTripAssembly .
w:marmishQualification p:addresses w:roundTripClaims .

w:witPublicationEvidence a p:Artifact ; rdfs:label "Component publication and empty-linker execution evidence" ;
    p:location "docs/design/component-publication-evidence.md" .
w:witPublication p:evidence w:witPublicationEvidence .
w:witReleaseReview a p:Finding ; rdfs:label "Specify the closed profile and pin the production interface used by the instrumented world" ;
    p:source w:witPublicationEvidence .
w:witPublication p:addresses w:witReleaseReview .

w:componentRuntimeEvidence a p:Artifact ; rdfs:label "Ledger component execution and host evidence" ;
    p:location "docs/design/component-execution-evidence.md" .
w:componentExecution p:evidence w:componentRuntimeEvidence .
w:componentUpperEndpoint a p:Finding ; rdfs:label "Detect a guest that rejects a credit exactly at the maximum signed balance" ; p:source w:componentRuntimeEvidence .
w:componentExecution p:addresses w:componentUpperEndpoint .
