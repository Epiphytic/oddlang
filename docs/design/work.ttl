w:wholeNullableDomain a p:Task ; rdfs:label "Recover and project a checked optional unsigned value" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:acceptance "Recover the interval, default and public error observations from an isolated pinned native build. Reproduce the graph in Rust and TypeScript and reject an independent boundary mutant." ;
    p:evidence w:wholeValueDomainSpec, w:wholeRetentionCaller .
w:wholeValueDomainSpec a p:Artifact ; p:location "docs/language/value-domains.md" .
w:wholeRetentionCaller a p:Artifact ; p:location "https://github.com/Epiphytic/marmish-oddlang/pull/7" .
w:wholeWorkspaceShapeArchive a p:Artifact ;
    p:location "https://github.com/Epiphytic/marmish-oddlang/commit/f6f31b50ab34ca59c9d60aaeb4b29035a9726b8f" .
w:wholeMarmishStructure p:evidence w:wholeWorkspaceShapeArchive .
w:boundedJsonEnvelopeProjection a p:Task ;
    rdfs:label "Project a generic bounded JSON envelope into a native Rust API" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:acceptance "Generate deterministic Rust from ordered envelope fields, wire bounds, shape policy and declared guards. An unrelated unchanged caller must detect field, size and precedence mutations and reject duplicate keys and noncanonical Base64." ;
    p:evidence w:boundedJsonEnvelopeFixture .
w:boundedJsonEnvelopeFixture a p:Artifact ; p:location "tests/json_envelope.rs" .
w:wholeMarmishProtocols p:dependsOn w:boundedJsonEnvelopeProjection .

w:boundedJsonEnvelopeBindingReview a p:Finding ;
    rdfs:label "Reject native type names that collide with the generated module and verify public error ordinals" ;
    p:source w:boundedJsonEnvelopeFixture .
w:boundedJsonEnvelopeProjection p:addresses w:boundedJsonEnvelopeBindingReview .
w:endpointSetNormalization a p:Task ;
    rdfs:label "Project ordered endpoint-set normalization to native Rust" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:evidence w:endpointSetEvidence ;
    p:acceptance "Build a deterministic checked native set with ordered errors and declared URL, DNS, IP and deduplication policy. Compile an unrelated consumer with an external error enum and exercise boundary cases." .

w:endpointSetEvidence a p:Artifact ;
    rdfs:label "Locked offline endpoint-set qualification with an unrelated Rust consumer" ;
    p:location "verification/endpoint-set/README.md" .
w:wholeMarmishProtocols p:dependsOn w:endpointSetNormalization .

w:orderedEndpointPolicyReview a p:Finding ;
    rdfs:label "Require typed address classification and explicit loopback opt-in before projection" ;
    p:source w:orderedEndpointPolicyGuardFixture .
w:orderedEndpointPolicyGuardFixture a p:Artifact ; p:location "verification/endpoint-set/verify.py" .
w:endpointSetNormalization p:addresses w:orderedEndpointPolicyReview ; p:evidence w:orderedEndpointPolicyGuardFixture .
w:nativePackageAssembly a p:Task ; rdfs:label "Assemble pinned semantic projections into a native Rust library" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:acceptance "Independently project two unrelated codecs into one private module, expose their selected public types, compile the consumer offline with its pinned dependency closure, and reject stale pins, inconsistent bindings and competing publication on the qualified hosts." ;
    p:evidence w:nativePackageFixture .
w:nativePackageFixture a p:Artifact ; p:location "verification/native-package/verify.py" .

w:boundedIntegrityBlocks a p:Task ;
    rdfs:label "Project positioned integrity blocks from portable semantics" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:acceptance "Generate bounded native identity and optional compression, preserve wire field shape and guard precedence, and reject malformed members, dictionaries, trailing data and incorrect digest in an unrelated caller." ;
    p:evidence w:boundedIntegrityFixture .
w:boundedIntegrityFixture a p:Artifact ; p:location "verification/integrity-block/README.md" .
w:wholeMarmishProtocols p:dependsOn w:boundedIntegrityBlocks .

w:boundedIntegrityProjectionReview a p:Finding ;
    rdfs:label "Check native primitive name collisions, exhaustive wire diagnostics and encode size obligations" ;
    p:source w:boundedIntegrityFixture .
w:boundedIntegrityBlocks p:addresses w:boundedIntegrityProjectionReview .
w:sharedTypedDeclarations a p:Task ; rdfs:label "Project typed constants, named errors, result aliases and wire enums into native package scopes" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:dependsOn w:nativePackageAssembly ; p:status p:done ;
    p:acceptance "Qualify an unrelated native consumer against constant references and bounds, interpolated errors, native ordering, Serde wire values, and public and crate-private paths. Bind every declaration to a portable obligation." ;
    p:evidence w:sharedTypedFixture .
w:sharedTypedFixture a p:Artifact ; p:location "verification/shared-declarations/verify.py" .

w:sharedFormatterReview a p:Finding ; rdfs:label "Forwarding outer formatter options into an embedded payload changes its observable text" ; p:source w:sharedTypedFixture .
w:sharedTypedDeclarations p:addresses w:sharedFormatterReview .
w:sequenceJournalPlan a p:Artifact ;
    p:location "docs/superpowers/plans/2026-11-26-sequence-journal.md" .
w:sequenceJournal a p:Task ;
    rdfs:label "Project bounded byte journals and ordered receipt transitions" ;
    p:milestone w:marmishMilestone ; p:source w:sequenceJournalPlan ; p:status p:done ;
    p:dependsOn w:nativePackageAssembly, w:sharedTypedDeclarations ;
    p:evidence w:sequenceJournalFixture ;
    p:acceptance "An unrelated native caller exercises declared byte and record limits, partial acknowledgement, receipt eviction, ordered rejection and transaction rollback. The package assembler accepts the pinned semantic component." .

w:sequenceJournalFixture a p:Artifact ;
    p:location "verification/sequence-journal/README.md" .
w:wholeMarmishProtocols p:dependsOn w:sequenceJournal .

w:sequenceJournalPrivateStorage a p:Finding ;
    rdfs:label "Native window private field identity remains unbound" ;
    p:source w:sequenceJournalFixture ;
    p:reason "Three white-box reference tests need two private observations: the receipt container and a struct literal for cursor fields. The journal target retains the authoritative state behind an internal store." .
w:wholeMarmishStructure p:addresses w:sequenceJournalPrivateStorage .

w:sequenceJournalNativeStorage a p:Task ;
    rdfs:label "Bind authoritative private target storage for native window tests" ;
    p:milestone w:marmishMilestone ; p:source w:sequenceJournalPlan ; p:status p:done ;
    p:dependsOn w:sequenceJournal ; p:addresses w:sequenceJournalPrivateStorage ;
    p:evidence w:sequenceJournalFixture ;
    p:acceptance "Lexical child tests can construct native cursor fields and inspect the actual receipt queue. Downstream consumers cannot access the fields directly, and the public state behavior remains compatible." .
