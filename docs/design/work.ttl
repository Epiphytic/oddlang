w:nestedCodecProviderMaximum a p:Decision ;
    rdfs:label "Require each nested slot to cover the provider's declared maximum" ;
    p:source w:nestedCodecMaximumReview ;
    p:reason "A native value accepted by the complete provider should fit the parent slot without a separate byte check." .
w:nestedCodecMaximumReview a p:Artifact ;
    p:location <https://github.com/Epiphytic/oddlang/pull/108> .
w:independentNestedCodecBounds a p:Decision ;
    rdfs:label "Check codec and enclosing slot bounds independently" ;
    p:source w:nestedCodecPackageFixture, w:compositePackageFixture ;
    p:supersedes w:nestedCodecProviderMaximum ;
    p:reason "A nested slot has its own named overflow contract. Structural minimum width determines whether the slot can hold a value. An explicit codecMaximum checks the provider's exact aggregate limit, and runtime encoders and decoders continue to enforce the slot limit." .

