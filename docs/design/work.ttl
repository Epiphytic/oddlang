w:marmishGaps a p:Artifact ; rdfs:label "Retained module register and reduction fixtures" ; p:location "examples/marmish/gaps.json" .
w:marmish-capability-modules a p:Task ; rdfs:label "public module and re-export resolution" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:done ; p:evidence w:marmishQualificationEvidence ; p:acceptance "public path and type identity agree; reject an ambiguous or cfg-dependent re-export." .
w:marmish-capability-config a p:Task ; rdfs:label "URL normalization and configuration validators" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:blocked ; p:reason "The current closed Rust profiles cannot establish these input and effect semantics." ; p:acceptance "valid inputs have the same normalized values; reject invalid URLs with the same first error." .
w:marmish-capability-wire a p:Task ; rdfs:label "numbered Rust enum tags and checked binary cursors" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:blocked ; p:reason "The current closed Rust profiles cannot establish these input and effect semantics." ; p:acceptance "encode and decode exact original bytes; reject unknown tags and truncated input." .
w:marmish-capability-offset a p:Task ; rdfs:label "bounded offsets and ordered window transitions" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:blocked ; p:reason "The current closed Rust profiles cannot establish these input and effect semantics." ; p:acceptance "resume at the admissible offset; preserve the original error on a gap or overflow." .
w:marmish-capability-compression a p:Task ; rdfs:label "bounded external compression primitive" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:blocked ; p:reason "The current closed Rust profiles cannot establish these input and effect semantics." ; p:acceptance "match decompressed bytes and output bounds; reject an invalid or oversized block." .
w:marmish-capability-native a p:Task ; rdfs:label "general Rust bodies and native dependency resolution" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:blocked ; p:reason "The current closed Rust profiles cannot establish these input and effect semantics." ; p:acceptance "compare the reduced entry point and all observable state with the pinned original; reject an unresolved import, effect or expansion." .
w:marmish-capability-os a p:Task ; rdfs:label "platform-specific library calls and observable OS effects" ; p:source w:marmishGaps ; p:milestone w:marmishMilestone ; p:status p:blocked ; p:reason "The current closed Rust profiles cannot establish these input and effect semantics." ; p:acceptance "replay declared local outcomes on the named platform; reject an undeclared capability." .

