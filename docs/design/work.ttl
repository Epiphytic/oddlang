w:integratedNativeInterfaces a p:Task ; rdfs:label "Build one composed native release with current copy and status interfaces" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ; p:evidence w:integratedClientReceipt ;
    p:dependsOn w:combinedNativeRelease, w:copyFieldRelationQualification ;
    p:acceptance "Recover source-independent packages together from one root lock and run mixed discovery and upstream library cases on the resulting artifacts." .
w:foregroundProfileOwnerPlan a p:Artifact ;
    p:location "docs/superpowers/plans/2026-11-26-foreground-profile-owner.md" .
w:foregroundProfileOwner a p:Task ;
