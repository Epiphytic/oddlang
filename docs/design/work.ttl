w:localOwnerTlsOracle a p:Task ; rdfs:label "Freeze direct relay admission, activation and failed TLS cleanup" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:acceptance "Compare loopback plaintext rejection and private-certificate TLS rejection, exact status while the handshake is held and terminal output on both ARM64 hosts." ;
    p:evidence w:localOwnerTlsReceipt .
