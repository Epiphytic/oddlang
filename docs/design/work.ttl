    p:milestone w:marmishMilestone ; p:source w:nativeFileProfilePlan ; p:status p:done ;
    p:dependsOn w:nativeFileProfilePreparation ;
    p:acceptance "Initialize and reopen both native encrypted stores before publishing ready identity; independently verify schema versions and counts before either peer can repair a fresh or pristine current-format profile using explicit direct relay and file backing." ;
    p:evidence w:nativeFileProfileStoreReceipt, w:nativeJournalSchemaFixture .
w:nativeFileProfileStoreReceipt a p:Artifact ;
    p:location "companion:verification/whole/status/encrypted-init-macos-arm64.json" .
w:nativeJournalSchemaFixture a p:Artifact ;
    p:location "src/file_profile/schema.rs" .
w:nativeFileProfileExtendedInit a p:Task ;
    rdfs:label "Extend initialization to config-selected routing and stored-state replay" ;
    p:milestone w:marmishMilestone ; p:source w:nativeFileProfilePlan ; p:status p:planned ;
    p:dependsOn w:nativeFileProfileStores ;
    p:acceptance "Qualify OS-default state selection, persisted config, keychain, Tor and current or older nonempty storage with native replay and migration witnesses." .
w:compositeBinaryRecords a p:Task ; rdfs:label "Project checked nested and checksummed composite binary records" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:dependsOn w:binaryMetadataRecords ;
