w:boundedTaggedBinaryFrames a p:Task ; rdfs:label "Project bounded tagged binary frames and incremental parsers" ;
    p:milestone w:marmishMilestone ; p:source w:wholeMarmishPlan ; p:status p:done ;
    p:dependsOn w:compositeBinaryRecords, w:copyFieldRelationQualification ;
    p:acceptance "Verify exact envelope tags, header limits, ordered case checks, terminal bytes, nested fragments and incremental poisoned-input behavior against an independent native fixture." ;
